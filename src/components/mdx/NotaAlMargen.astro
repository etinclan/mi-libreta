---
---
<aside class="nota-margen">
  <slot />
</aside>

<style>
  .nota-margen {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--etcom-smoke);
  }

  /* Mobile / tablet — bloque inline */
  .nota-margen {
    display: block;
    background: var(--etcom-vitela-claro, #FAF6E8);
    border-left: 3px solid var(--etcom-oro, #D4B976);
    padding: 12px 16px;
    margin: 1.5em 0;
    border-radius: 0 3px 3px 0;
  }

  .nota-margen :global(p) {
    margin: 0;
    font-size: 0.8125rem;
    font-family: var(--font-sans);
    line-height: 1.6;
    color: var(--etcom-humo, #6E6F75);
  }

  /* Desktop — flota fuera de la columna de lectura */
  @media (min-width: 1100px) {
    .nota-margen {
      float: right;
      clear: right;
      width: 180px;
      margin: 0.4em -220px 1em 24px;
      background: transparent;
      border-left: none;
      border-top: 1px solid var(--etcom-oro, #D4B976);
      padding: 10px 0 0;
    }
  }
</style>
