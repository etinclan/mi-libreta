---
interface Props {
  lista: string[];
}
const { lista } = Astro.props;
---
<div class="territorios">
  {lista.map((t, i) => (
    <>
      <a href="/jardin" class="territorio">{t}</a>
      {i < lista.length - 1 && <span class="sep" aria-hidden="true">·</span>}
    </>
  ))}
</div>

<style>
  .territorios {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 1em 0;
  }
  .territorio {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--etcom-lapis, #26358C);
    text-decoration: none;
    padding: 3px 8px;
    border: 1px solid var(--etcom-oro, #D4B976);
    border-radius: 3px;
    transition: background 0.15s;
  }
  .territorio:hover {
    background: var(--etcom-oro-suave, #E5D4A3);
    color: var(--etcom-lapis-noche, #0F1340);
  }
  .sep {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--etcom-humo-claro, #B5B5BA);
  }
</style>
