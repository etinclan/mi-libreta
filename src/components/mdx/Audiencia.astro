---
---
<aside class="audiencia">
  <span class="label">Asumo que…</span>
  <div class="contenido">
    <slot />
  </div>
</aside>

<style>
  .audiencia {
    border-left: 3px solid var(--etcom-lapis-vivo, #3445A8);
    background: var(--etcom-vitela-claro, #FAF6E8);
    padding: 20px 24px;
    margin: 2em 0;
    border-radius: 0 4px 4px 0;
  }
  .label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--etcom-lapis, #26358C);
    margin-bottom: 10px;
  }
  .contenido {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    font-style: italic;
    line-height: 1.8;
    color: var(--etcom-lapis-noche, #0F1340);
  }
  .contenido :global(p) {
    margin: 0;
  }
</style>
