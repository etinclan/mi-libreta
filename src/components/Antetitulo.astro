---
interface Props { texto: string; }
const { texto } = Astro.props;
---
<div class="antetitulo">
  <span class="marcador" aria-hidden="true"></span>
  <span class="tag">{texto}</span>
</div>

<style>
  .antetitulo {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .marcador {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--etcom-oro, #D4B976);
    border-radius: 1px;
    flex-shrink: 0;
  }
  .tag {
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--etcom-lapis, #26358C);
  }
</style>
