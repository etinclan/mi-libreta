---
interface Props { texto: string; }
const { texto } = Astro.props;
---
<div class="antetitulo">
  <span class="marcador" aria-hidden="true"></span>
  <span class="tag">{texto}</span>
</div>

<style>
  .antetitulo {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .marcador {
    display: block;
    width: 24px;
    height: 2px;
    background: #5EECC5;
    border-radius: 1px;
    flex-shrink: 0;
  }
  .tag {
    font-family: 'Lato', sans-serif;
    font-size: calc(((14.5 / 16) * 1rem) + (15 - 14.5) * var(--fluid-bp, 0));
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #5EECC5;
  }
</style>
