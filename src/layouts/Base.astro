---
const { title = "Mi Libreta" } = Astro.props;
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <nav>
      <a href="/" class="logo">Eduardo Toledo</a>
      <div class="links">
        <a href="/jardin">Mi Libreta</a>
        <a href="/newsletter">Newsletter</a>
        <a href="/estudio">Estudio</a>
        <a href="/organizaciones">Organizaciones</a>
        <a href="/ahora">Ahora</a>
        <a href="/sobre">Sobre mí</a>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <span>© Eduardo Toledo</span>
        <nav class="footer-links">
          <a href="/colofon">Colofón</a>
          <a href="https://github.com/etinclan/mi-libreta" target="_blank" rel="noopener">GitHub</a>
          <a href="https://eduardotoledo.substack.com" target="_blank" rel="noopener">Substack</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    /* Fluid type scale — mismos rangos que Maggie Appleton */
    --fluid-min-width: 320;
    --fluid-max-width: 1200;
    --fluid-screen: 100vw;
    --fluid-bp: calc(
      (var(--fluid-screen) - var(--fluid-min-width) / 16 * 1rem) /
      (var(--fluid-max-width) - var(--fluid-min-width))
    );

    --font-size-xs:   calc(((14.5 / 16) * 1rem) + (15   - 14.5) * var(--fluid-bp));
    --font-size-sm:   calc(((16   / 16) * 1rem) + (16.5 - 16  ) * var(--fluid-bp));
    --font-size-base: calc(((20   / 16) * 1rem) + (22   - 20  ) * var(--fluid-bp));
    --font-size-md:   calc(((25   / 16) * 1rem) + (28.6 - 25  ) * var(--fluid-bp));
    --font-size-lg:   calc(((30   / 16) * 1rem) + (36   - 30  ) * var(--fluid-bp));
    --font-size-xl:   calc(((39   / 16) * 1rem) + (44   - 39  ) * var(--fluid-bp));
    --font-size-2xl:  calc(((47   / 16) * 1rem) + (56   - 47  ) * var(--fluid-bp));
    --font-size-3xl:  calc(((58   / 16) * 1rem) + (82   - 58  ) * var(--fluid-bp));

    --font-serif-display: 'DM Serif Display', serif;
    --font-serif-text:    'Cormorant Garamond', serif;
    --font-sans:          'Lato', sans-serif;

    --color-bg:        #1C1B18;
    --color-text:      #C2BFB2;
    --color-text-dim:  #7A7773;
    --color-text-bright: #E8E5DF;
    --color-border:    #2A2927;
    --color-accent:    #E85AAB;
  }

  @media screen and (min-width: 1200px) {
    :root { --fluid-screen: calc(1200 * 1px); }
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    line-height: 2;
    -webkit-font-smoothing: antialiased;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 80px;
    border-bottom: 1px solid var(--color-border);
  }

  .logo {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-md);
    color: var(--color-text-bright);
    text-decoration: none;
  }

  .links {
    display: flex;
    gap: 40px;
  }

  .links a {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: 300;
    color: var(--color-text-dim);
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  .links a:hover { color: var(--color-text); }

  main {
    padding: 80px;
    max-width: 1100px;
    margin: 0 auto;
  }

  footer {
    border-top: 1px solid var(--color-border);
    margin-top: 80px;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px 80px;
  }
  footer span {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    color: #5A5855;
  }
  .footer-links {
    display: flex;
    gap: 32px;
  }
  .footer-links a {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    color: var(--color-text-dim);
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .footer-links a:hover { color: var(--color-text); }

  @media (max-width: 700px) {
    nav { padding: 20px 24px; }
    main { padding: 40px 24px; }
    .footer-inner { padding: 20px 24px; flex-direction: column; gap: 16px; align-items: flex-start; }
  }
</style>
