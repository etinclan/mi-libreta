---
const { title = "La Libreta" } = Astro.props;
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Hanken+Grotesk:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
  </head>
  <body>
    <nav>
      <a href="/" class="logo"><img src="/Logo-EduardoToledo.png" alt="Eduardo Toledo" class="logo-img" /></a>
      <div class="links">
        <a href="/jardin">La Libreta</a>
        <a href="/newsletter">Newsletter</a>
        <div class="dropdown">
          <a href="/el-nuevo-juego" class="dropdown-trigger">El nuevo juego <span class="chevron" aria-hidden="true">›</span></a>
          <div class="dropdown-menu">
            <a href="/personas" class="dropdown-item">
              <span class="dropdown-item-title">Personas</span>
              <span class="dropdown-item-desc">Formaciones para reposicionarte</span>
            </a>
            <a href="/organizaciones" class="dropdown-item">
              <span class="dropdown-item-title">Organizaciones</span>
              <span class="dropdown-item-desc">Programas estratégicos a medida</span>
            </a>
          </div>
        </div>
        <a href="/ahora">Ahora</a>
        <a href="/sobre">Sobre mí</a>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <span>© Eduardo Toledo</span>
        <nav class="footer-links">
          <a href="/colofon">Colofón</a>
          <a href="https://github.com/etinclan/mi-libreta" target="_blank" rel="noopener">GitHub</a>
          <a href="https://eduardotoledo.substack.com" target="_blank" rel="noopener">Substack</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    /* Fluid type scale — mismos rangos que Maggie Appleton */
    --fluid-min-width: 320;
    --fluid-max-width: 1200;
    --fluid-screen: 100vw;
    --fluid-bp: calc(
      (var(--fluid-screen) - var(--fluid-min-width) / 16 * 1rem) /
      (var(--fluid-max-width) - var(--fluid-min-width))
    );

    --font-size-xs:   calc(((14.5 / 16) * 1rem) + (15   - 14.5) * var(--fluid-bp));
    --font-size-sm:   calc(((16   / 16) * 1rem) + (16.5 - 16  ) * var(--fluid-bp));
    --font-size-base: calc(((20   / 16) * 1rem) + (22   - 20  ) * var(--fluid-bp));
    --font-size-md:   calc(((25   / 16) * 1rem) + (28.6 - 25  ) * var(--fluid-bp));
    --font-size-lg:   calc(((30   / 16) * 1rem) + (36   - 30  ) * var(--fluid-bp));
    --font-size-xl:   calc(((39   / 16) * 1rem) + (44   - 39  ) * var(--fluid-bp));
    --font-size-2xl:  calc(((47   / 16) * 1rem) + (56   - 47  ) * var(--fluid-bp));
    --font-size-3xl:  calc(((58   / 16) * 1rem) + (82   - 58  ) * var(--fluid-bp));

    /* Paleta Disruptiva v1.0 — Explorer + Sage */
    --font-serif-display: 'Cormorant Garamond', Georgia, serif;
    --font-serif-text:    'Lora', Georgia, serif;
    --font-sans:          'Hanken Grotesk', system-ui, sans-serif;

    /* Lienzos y estructura */
    --color-bg:          #F6F1E8;  /* pergamino */
    --color-text:        #26242E;  /* tinta */
    --color-text-dim:    rgba(59,30,84,0.58);  /* meta */
    --color-text-bright: #3B1E54;  /* mora — titulares */
    --color-border:      rgba(59,30,84,0.14);  /* linea */
    --color-accent:      #D94F2A;  /* rojo */

    /* Tokens directos */
    --mora:          #3B1E54;
    --mora-deep:     #2C1640;
    --pergamino:     #F6F1E8;
    --tinta:         #26242E;
    --niebla:        #E7E3F2;
    --linea:         rgba(59,30,84,.14);
    --linea-clara:   rgba(245,239,230,.12);
    --meta:          rgba(59,30,84,.58);
    --meta-clara:    rgba(245,239,230,.62);
    --rojo:          #D94F2A;
    --rojo-deep:     #B83C1C;
    --lima:          #C7FF3C;
    --lima-mark:     rgba(199,255,60,.55);
    --lavanda:       #B9AFD8;

    /* Aliases ETCOM → Paleta Disruptiva (mantienen compatibilidad con componentes) */
    --etcom-lapis:         #3B1E54;   /* mora */
    --etcom-lapis-vivo:    #4A2766;   /* mora más vivo — hover */
    --etcom-lapis-noche:   #3B1E54;   /* mora — titulares */
    --etcom-oro:           #D94F2A;   /* rojo — acento estructural */
    --etcom-oro-suave:     rgba(217,79,42,0.15);
    --etcom-vitela:        #F6F1E8;   /* pergamino */
    --etcom-vitela-claro:  #FAF7F2;   /* pergamino elevado */
    --etcom-humo:          rgba(59,30,84,0.58);  /* meta */
    --etcom-humo-claro:    #E7E3F2;   /* niebla */

    /* Legacy (componentes con nombres anteriores) */
    --etcom-coral:    #D94F2A;  /* rojo */
    --etcom-mint:     #C7FF3C;  /* lima */
    --etcom-midnight: #26242E;  /* tinta */
    --etcom-cream:    #F6F1E8;  /* pergamino */
    --etcom-smoke:    rgba(59,30,84,0.58);  /* meta */
  }

  @media screen and (min-width: 1200px) {
    :root { --fluid-screen: calc(1200 * 1px); }
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 80px;
    border-bottom: 1px solid var(--color-border);
  }

  .logo {
    text-decoration: none;
    display: flex;
    align-items: center;
  }
  .logo-img {
    height: 54px;
    width: auto;
    display: block;
  }

  .links {
    display: flex;
    gap: 40px;
  }

  .links a {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--etcom-humo);
    text-decoration: none;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .links a:hover { color: var(--rojo); }

  /* Dropdown */
  .dropdown {
    position: relative;
  }
  .dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 4px;
    cursor: default;
  }
  .chevron {
    font-size: 0.7rem;
    transition: transform 0.15s;
    display: inline-block;
  }
  .dropdown:hover .chevron { transform: rotate(90deg); }

  .dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 16px);
    right: 0;
    min-width: 220px;
    background: var(--etcom-vitela-claro);
    border: 1px solid var(--etcom-oro);
    border-radius: 4px;
    padding: 8px;
    z-index: 100;
    box-shadow: 0 8px 24px rgba(59,30,84,0.12);
  }
  .dropdown:hover .dropdown-menu { display: flex; flex-direction: column; gap: 2px; }

  .dropdown-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px;
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.12s;
  }
  .dropdown-item:hover { background: var(--etcom-oro-suave); color: inherit; }
  .dropdown-item-title {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--etcom-lapis-noche);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .dropdown-item-desc {
    font-family: var(--font-serif-text);
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--etcom-humo);
    letter-spacing: 0;
    text-transform: none;
  }

  main {
    padding: 80px;
    max-width: 1100px;
    margin: 0 auto;
  }

  footer {
    border-top: 1px solid var(--color-border);
    margin-top: 80px;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px 80px;
  }
  footer span {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--etcom-humo);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .footer-links {
    display: flex;
    gap: 32px;
  }
  .footer-links a {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--etcom-humo);
    text-decoration: none;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .footer-links a:hover { color: var(--rojo); }

  @media (max-width: 700px) {
    nav { padding: 20px 24px; }
    main { padding: 40px 24px; }
    .footer-inner { padding: 20px 24px; flex-direction: column; gap: 16px; align-items: flex-start; }
  }
</style>
