---
const { title = "Eduardo Toledo" } = Astro.props;
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Hanken+Grotesk:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Eduardo Toledo",
  "url": "https://eduardotoledo.com",
  "sameAs": [
    "https://linkedin.com/in/eduardotoledo",
    "https://x.com/eduardotoledo"
  ],
  "jobTitle": "Consultor de relevancia profesional y organizacional en la era de la IA",
  "description": "Ayuda a profesionales y organizaciones a rediseñar su relevancia ante el nuevo juego de la IA. Marcos de trabajo, herramientas y programas de acompañamiento.",
  "knowsAbout": ["Inteligencia Artificial", "Relevancia profesional", "Transformación organizacional", "Futuros del trabajo"],
  "address": { "@type": "PostalAddress", "addressLocality": "Madrid", "addressCountry": "ES" }
}
    </script>
  </head>
  <body>
    <nav aria-label="Navegación principal">
      <a href="/" class="logo"><img src="/Logo-EduardoToledo.png" alt="Eduardo Toledo" class="logo-img" /></a>
      <div class="links">
        <a href="/cuaderno">Cuaderno</a>
        <a href="/marcos">Marcos</a>
        <a href="/herramientas">Herramientas</a>
        <div class="dropdown">
          <a href="/programas" class="dropdown-trigger">Programas <span class="chevron" aria-hidden="true">›</span></a>
          <div class="dropdown-menu">
            <a href="/programas#reframe-game" class="dropdown-item">
              <span class="dropdown-item-title">El gran reajuste</span>
              <span class="dropdown-item-desc">Cómo ser relevante en cuatro pasos</span>
            </a>
            <a href="/programas#reframe-yourself" class="dropdown-item">
              <span class="dropdown-item-title">Reframe yourself</span>
              <span class="dropdown-item-desc">Rediseña tu relevancia profesional</span>
            </a>
            <a href="/programas#reframe-business" class="dropdown-item">
              <span class="dropdown-item-title">Reframe business</span>
              <span class="dropdown-item-desc">Para organizaciones y equipos</span>
            </a>
          </div>
        </div>
        <a href="/sobre">Sobre mí</a>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <span>© Eduardo Toledo</span>
        <nav class="footer-links" aria-label="Navegación secundaria">
          <a href="/colofon">Colofón</a>
          <a href="https://github.com/etinclan/mi-libreta" target="_blank" rel="noopener">GitHub</a>
          <a href="https://eduardotoledo.substack.com" target="_blank" rel="noopener">Substack</a>
          <a href="/llms.txt">llms.txt</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    /* Fluid type scale */
    --fluid-min-width: 320;
    --fluid-max-width: 1200;
    --fluid-screen: 100vw;
    --fluid-bp: calc(
      (var(--fluid-screen) - var(--fluid-min-width) / 16 * 1rem) /
      (var(--fluid-max-width) - var(--fluid-min-width))
    );

    --font-size-xs:   calc(((14.5 / 16) * 1rem) + (15   - 14.5) * var(--fluid-bp));
    --font-size-sm:   calc(((16   / 16) * 1rem) + (16.5 - 16  ) * var(--fluid-bp));
    --font-size-base: calc(((20   / 16) * 1rem) + (22   - 20  ) * var(--fluid-bp));
    --font-size-md:   calc(((25   / 16) * 1rem) + (28.6 - 25  ) * var(--fluid-bp));
    --font-size-lg:   calc(((30   / 16) * 1rem) + (36   - 30  ) * var(--fluid-bp));
    --font-size-xl:   calc(((39   / 16) * 1rem) + (44   - 39  ) * var(--fluid-bp));
    --font-size-2xl:  calc(((47   / 16) * 1rem) + (56   - 47  ) * var(--fluid-bp));
    --font-size-3xl:  calc(((58   / 16) * 1rem) + (82   - 58  ) * var(--fluid-bp));

    /* Paleta Disruptiva v1.0 */
    --font-serif-display: 'Cormorant Garamond', Georgia, serif;
    --font-serif-text:    'Lora', Georgia, serif;
    --font-sans:          'Hanken Grotesk', system-ui, sans-serif;

    /* Lienzos y estructura */
    --color-bg:          #F6F1E8;
    --color-text:        #26242E;
    --color-text-dim:    rgba(59,30,84,0.58);
    --color-text-bright: #3B1E54;
    --color-border:      rgba(59,30,84,0.14);
    --color-accent:      #D94F2A;

    /* Tokens directos */
    --mora:          #3B1E54;
    --mora-deep:     #2C1640;
    --pergamino:     #F6F1E8;
    --tinta:         #26242E;
    --niebla:        #E7E3F2;
    --linea:         rgba(59,30,84,.14);
    --linea-clara:   rgba(245,239,230,.12);
    --meta:          rgba(59,30,84,.58);
    --meta-clara:    rgba(245,239,230,.62);
    --rojo:          #D94F2A;
    --rojo-deep:     #B83C1C;
    --lima:          #C7FF3C;
    --lima-mark:     rgba(199,255,60,.55);
    --lavanda:       #B9AFD8;

    /* Aliases ETCOM → Paleta Disruptiva (mantienen compatibilidad con componentes) */
    --etcom-lapis:         #3B1E54;
    --etcom-lapis-vivo:    #4A2766;
    --etcom-lapis-noche:   #3B1E54;
    --etcom-oro:           #D94F2A;
    --etcom-oro-suave:     rgba(217,79,42,0.15);
    --etcom-vitela:        #F6F1E8;
    --etcom-vitela-claro:  #FAF7F2;
    --etcom-humo:          rgba(59,30,84,0.58);
    --etcom-humo-claro:    #E7E3F2;

    /* Legacy */
    --etcom-coral:    #D94F2A;
    --etcom-mint:     #C7FF3C;
    --etcom-midnight: #26242E;
    --etcom-cream:    #F6F1E8;
    --etcom-smoke:    rgba(59,30,84,0.58);
  }

  @media screen and (min-width: 1200px) {
    :root { --fluid-screen: calc(1200 * 1px); }
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 80px;
    border-bottom: 1px solid var(--linea);
  }

  .logo {
    text-decoration: none;
    display: flex;
    align-items: center;
  }
  .logo-img {
    height: 54px;
    width: auto;
    display: block;
  }

  .links {
    display: flex;
    gap: 40px;
    align-items: center;
  }

  .links > a,
  .links > .dropdown > .dropdown-trigger {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--meta);
    text-decoration: none;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .links > a:hover,
  .links > .dropdown:hover > .dropdown-trigger {
    color: var(--rojo);
  }

  /* Dropdown */
  .dropdown {
    position: relative;
  }
  .dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 4px;
    cursor: default;
  }
  .chevron {
    font-size: 0.7rem;
    transition: transform 0.15s;
    display: inline-block;
  }
  .dropdown:hover .chevron { transform: rotate(90deg); }

  .dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 16px);
    right: 0;
    min-width: 240px;
    background: #FAF7F2;
    border: 1px solid var(--linea);
    border-top: 2px solid var(--rojo);
    border-radius: 4px;
    padding: 8px;
    z-index: 100;
    box-shadow: 0 8px 24px rgba(59,30,84,0.12);
  }
  .dropdown:hover .dropdown-menu { display: flex; flex-direction: column; gap: 2px; }

  .dropdown-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px;
    border-radius: 3px;
    text-decoration: none;
    transition: background 0.12s;
  }
  .dropdown-item:hover { background: rgba(217,79,42,0.08); }
  .dropdown-item-title {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--mora);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .dropdown-item-desc {
    font-family: var(--font-serif-text);
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--meta);
    letter-spacing: 0;
    text-transform: none;
  }

  main {
    padding: 80px;
    max-width: 1100px;
    margin: 0 auto;
  }

  footer {
    border-top: 1px solid var(--linea);
    margin-top: 80px;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px 80px;
  }
  footer span {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--meta);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .footer-links {
    display: flex;
    gap: 32px;
  }
  .footer-links a {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--meta);
    text-decoration: none;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .footer-links a:hover { color: var(--rojo); }

  @media (max-width: 700px) {
    nav { padding: 20px 24px; }
    main { padding: 40px 24px; }
    .footer-inner { padding: 20px 24px; flex-direction: column; gap: 16px; align-items: flex-start; }
  }
</style>
