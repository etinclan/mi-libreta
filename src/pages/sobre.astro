---
import Base from '../layouts/Base.astro';

// DATOS A RELLENAR
const tagline = "[TAGLINE — ej: Futurista, comunicador, curioso de lo siguiente]";
const rolActual = "[ROL ACTUAL — ej: Futurista independiente y speaker internacional]";

const contexto = `[PÁRRAFO CONTEXTO — ~150 palabras. Describe qué haces hoy, cómo se conectan tus disciplinas,
en qué proyectos estás. Tono conversacional, primera persona.]`;

const historia = `[PÁRRAFO HISTORIA — ~150 palabras. De dónde eres, qué estudiaste, cómo llegaste aquí.
Puedes incluir giros inesperados o humor.]`;

const roles = [
  { empresa: "[EMPRESA O PROYECTO]", rol: "[ROL]", periodo: "[AÑO–AÑO]" },
  { empresa: "[EMPRESA O PROYECTO]", rol: "[ROL]", periodo: "[AÑO–AÑO]" },
  { empresa: "[EMPRESA O PROYECTO]", rol: "[ROL]", periodo: "[AÑO–AÑO]" },
];

const obsesiones = [
  { titulo: "[TEMA 1]", desc: "[Una línea sobre por qué te importa]" },
  { titulo: "[TEMA 2]", desc: "[Una línea sobre por qué te importa]" },
  { titulo: "[TEMA 3]", desc: "[Una línea sobre por qué te importa]" },
];

const links = [
  { label: "LinkedIn", url: "#" },
  { label: "Twitter / X", url: "#" },
  { label: "Email", url: "mailto:TU@EMAIL.COM" },
];
---

<Base title="Sobre mí · Eduardo Toledo">
  <div class="sobre">

    <header class="hero">
      <h1>Eduardo Toledo</h1>
      <p class="tagline">{tagline}</p>
    </header>

    <section>
      <h2>Un poco de contexto</h2>
      <p>{contexto}</p>

      <div class="roles">
        {roles.map(r => (
          <div class="rol">
            <span class="empresa">{r.empresa}</span>
            <span class="sep">—</span>
            <span class="cargo">{r.rol}</span>
            <span class="periodo">{r.periodo}</span>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2>Un poco de historia</h2>
      <p>{historia}</p>
    </section>

    <section>
      <h2>Lo que me obsesiona ahora</h2>
      <ul class="obsesiones">
        {obsesiones.map(o => (
          <li>
            <strong>{o.titulo}</strong>
            <span>{o.desc}</span>
          </li>
        ))}
      </ul>
    </section>

    <footer class="contacto">
      <p>¿Quieres hablar?</p>
      <div class="links">
        {links.map(l => (
          <a href={l.url} target="_blank" rel="noopener">{l.label}</a>
        ))}
      </div>
    </footer>

  </div>
</Base>

<style>
  .sobre {
    max-width: 680px;
  }

  /* Hero */
  .hero {
    margin-bottom: 72px;
  }
  h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 400;
    color: #E8E5DF;
    margin-bottom: 12px;
  }
  .tagline {
    font-size: 18px;
    font-weight: 300;
    color: #7A7773;
    font-style: italic;
  }

  /* Sections */
  section {
    margin-bottom: 64px;
  }
  h2 {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #7A7773;
    margin-bottom: 20px;
  }
  p {
    font-size: 17px;
    font-weight: 300;
    line-height: 1.8;
    color: #C2BFB2;
    margin-bottom: 24px;
    white-space: pre-line;
  }

  /* Roles */
  .roles {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .rol {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 15px;
    padding: 12px 0;
    border-bottom: 1px solid #2A2927;
  }
  .empresa {
    font-family: 'Playfair Display', serif;
    font-size: 16px;
    color: #E8E5DF;
  }
  .sep { color: #3A3835; }
  .cargo {
    font-weight: 300;
    color: #A8A5A0;
    flex: 1;
  }
  .periodo {
    font-size: 13px;
    font-weight: 300;
    color: #5A5855;
  }

  /* Obsesiones */
  .obsesiones {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .obsesiones li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-left: 16px;
    border-left: 2px solid #2A2927;
  }
  .obsesiones strong {
    font-family: 'Playfair Display', serif;
    font-weight: 500;
    font-size: 17px;
    color: #E8E5DF;
  }
  .obsesiones span {
    font-size: 15px;
    font-weight: 300;
    color: #7A7773;
  }

  /* Contacto */
  .contacto {
    padding-top: 48px;
    border-top: 1px solid #2A2927;
  }
  .contacto p {
    font-size: 14px;
    font-weight: 300;
    color: #7A7773;
    margin-bottom: 16px;
  }
  .links {
    display: flex;
    gap: 24px;
  }
  .links a {
    font-size: 14px;
    font-weight: 300;
    color: #E85AAB;
    text-decoration: none;
    letter-spacing: 0.5px;
  }
  .links a:hover {
    text-decoration: underline;
  }
</style>
