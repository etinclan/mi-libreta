---
import Base from '../layouts/Base.astro';
import Antetitulo from '../components/Antetitulo.astro';

const roles = [
  { empresa: "Reinventarse",   rol: "Programa formativo para profesionales en la era de la IA", periodo: "2023–hoy" },
  { empresa: "IEBS",           rol: "Profesor · Diseño Organizacional, Master in Digital Project Management", periodo: "2022–hoy" },
  { empresa: "La Carta",       rol: "Newsletter mensual sobre agencia humana en la era de la IA", periodo: "2023–hoy" },
];

const obsesiones = [
  {
    titulo: "Agencia humana en la era de la IA",
    desc: "La pregunta no es qué pueden hacer las máquinas, sino qué dejamos de hacer cuando ellas pueden. Estoy convencido de que la próxima década se decide aquí.",
  },
  {
    titulo: "Aprender y enseñar cuando las máquinas saben",
    desc: "Si la IA da las respuestas, ¿qué hacemos con el músculo de pensar? Diseñar pedagogías adultas que no atrofien la inteligencia humana es el frente que más me interesa.",
  },
  {
    titulo: "Voz propia frente a la abundancia sintética",
    desc: "Cuando la mitad del texto que circula va a ser generado, comunicar como humano se vuelve un acto identitario. Escribir con sello, sostener una postura, no homogeneizarse.",
  },
];

const links = [
  { label: "LinkedIn",    url: "https://www.linkedin.com/in/eduardotoledoinclan/" },
  { label: "Twitter / X", url: "https://x.com/eduardotoledo" },
  { label: "Email",       url: "mailto:edutoledo@gmail.com" },
];
---

<Base title="Sobre mí · Eduardo Toledo">
  <div class="sobre">

    <header class="hero">
      <Antetitulo texto="SOBRE MÍ" />
      <h1>Eduardo Toledo</h1>
      <p class="tagline">Cartógrafo de lo emergente. Diseño mapas y formaciones para profesionales que se niegan al piloto automático.</p>
    </header>

    <section>
      <h2>Un poco de contexto</h2>
      <p>Llevo años trabajando en el cruce entre estrategia, aprendizaje y la nueva relación humano‑máquina. Mi trabajo, en una frase, es ayudar a profesionales y organizaciones a reposicionarse cuando las reglas del juego cambian más rápido de lo que se leen.</p>
      <p>Diseño y facilito programas formativos — el más maduro es <em>Reinventarse</em>, un itinerario de cuatro semanas para profesionales que quieren seguir siendo relevantes en la era de la IA. Trabajo también con organizaciones en programas más largos de anticipación estratégica. Soy profesor del módulo de Diseño Organizacional en el Master in Digital Project Management de IEBS y autor de <em>La Carta</em>, una newsletter mensual sobre agencia humana en la era de la IA.</p>
      <p>Esta web es mi cuaderno de campo: aquí publico ideas en distintos estados de madurez. Algunas son intuiciones a medio cocinar. Otras llevan años destilándose. Prefiero mostrar el levantamiento del mapa que solo el mapa terminado.</p>

      <div class="roles">
        {roles.map(r => (
          <div class="rol">
            <span class="empresa">{r.empresa}</span>
            <span class="sep">—</span>
            <span class="cargo">{r.rol}</span>
            <span class="periodo">{r.periodo}</span>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2>Un poco de historia</h2>
      <p class="placeholder">Pendiente de escribir — de dónde vienes, qué estudiaste, el giro que te trajo hasta aquí.</p>
    </section>

    <section>
      <h2>Lo que me obsesiona ahora</h2>
      <ul class="obsesiones">
        {obsesiones.map(o => (
          <li>
            <strong>{o.titulo}</strong>
            <span>{o.desc}</span>
          </li>
        ))}
      </ul>
    </section>

    <footer class="contacto">
      <p class="cta">¿Hablamos?</p>
      <div class="links">
        {links.map(l => (
          <a href={l.url} target={l.url.startsWith('mailto') ? undefined : '_blank'} rel="noopener">{l.label}</a>
        ))}
      </div>
    </footer>

  </div>
</Base>

<style>
  .sobre { max-width: 72ch; }

  .hero { margin-bottom: 72px; }
  h1 {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-2xl);
    font-weight: 400;
    color: var(--color-text-bright);
    margin-bottom: 16px;
  }
  .tagline {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-md);
    font-style: italic;
    line-height: 1.5;
    color: #A8A5A0;
  }

  section { margin-bottom: 64px; }
  h2 {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-bright);
    margin-bottom: 20px;
  }
  p {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    line-height: 2;
    color: var(--color-text);
    margin-bottom: 1.5em;
  }
  p em {
    font-style: italic;
    color: var(--color-text-bright);
  }
  .placeholder {
    color: #3A3835;
    font-style: italic;
  }

  /* Roles */
  .roles {
    margin-top: 36px;
    display: flex;
    flex-direction: column;
  }
  .rol {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .rol:first-child { border-top: 1px solid var(--color-border); }
  .empresa {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-base);
    color: var(--color-text-bright);
    white-space: nowrap;
  }
  .sep { color: #3A3835; }
  .cargo {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-sm);
    color: #A8A5A0;
    flex: 1;
    min-width: 160px;
  }
  .periodo {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    color: #5A5855;
    white-space: nowrap;
  }

  /* Obsesiones */
  .obsesiones {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .obsesiones li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 20px;
    border-left: 2px solid var(--color-border);
  }
  .obsesiones strong {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-md);
    font-weight: 400;
    color: var(--color-text-bright);
  }
  .obsesiones span {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    line-height: 2;
    color: var(--color-text-dim);
  }

  /* Contacto */
  .contacto {
    padding-top: 48px;
    border-top: 1px solid var(--color-border);
  }
  .cta {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    color: var(--color-text-dim);
    margin-bottom: 16px;
  }
  .links { display: flex; gap: 24px; }
  .links a {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: 300;
    color: var(--color-accent);
    text-decoration: none;
  }
  .links a:hover { text-decoration: underline; }
</style>
