---
import Base from '../../layouts/Base.astro';

const momentos = [
  { titulo: "[MOMENTO_1_TITULO]", desc: "[MOMENTO_1_DESC]" },
  { titulo: "[MOMENTO_2_TITULO]", desc: "[MOMENTO_2_DESC]" },
  { titulo: "[MOMENTO_3_TITULO]", desc: "[MOMENTO_3_DESC]" },
  { titulo: "[MOMENTO_4_TITULO]", desc: "[MOMENTO_4_DESC]" },
];

const formatos = [
  { nombre: "Meetup profesional", desc: "[FORMATO_MEETUP_DESC]" },
  { nombre: "Conferencia interna", desc: "[FORMATO_CONFERENCIA_DESC]" },
  { nombre: "Jornada de líderes", desc: "[FORMATO_JORNADA_DESC]" },
];
---

<Base title="Asomarse · Estudio · Eduardo Toledo">
  <div class="asomarse">

    <p class="breadcrumb"><a href="/estudio">← Estudio</a></p>

    <div class="type-label">
      <span class="marcador" aria-hidden="true"></span>
      <span class="tag">Taster</span>
    </div>

    <header class="hero">
      <h1>Asomarse</h1>
      <p class="subtitulo"><em>[SUBTITULO_HERO]</em></p>
    </header>

    <section class="manifiesto">
      <p>[MANIFIESTO_P1]</p>
      <p>[MANIFIESTO_P2]</p>
      <p>[MANIFIESTO_P3]</p>
    </section>

    <section class="para-quien">
      <h2>Para quién es</h2>
      <p>[PARA_QUIEN_DESC]</p>
      <p class="contraste"><em>[PARA_QUIEN_CONTRASTE — "No es para X. Es para Y."]</em></p>
    </section>

    <section class="momentos">
      <h2>Qué pasa en los 90 minutos</h2>
      <div class="momentos-lista">
        {momentos.map(m => (
          <div class="momento">
            <p class="momento-titulo"><em>{m.titulo}</em></p>
            <p class="momento-desc">{m.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="formatos">
      <h2>Formatos</h2>
      <div class="formatos-lista">
        {formatos.map(f => (
          <div class="formato">
            <span class="formato-nombre">{f.nombre}</span>
            <p class="formato-desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="entrada">
      <h2>Cómo entrar</h2>
      <p>[COMO_ENTRAR_DESC]</p>
      <a href="mailto:edutoledo@gmail.com" class="cta">Conversemos →</a>
    </section>

  </div>
</Base>

<style>
  :root {
    --mint:  #5EECC5;
    --coral: #FF8F6B;
  }

  .asomarse { max-width: 72ch; }

  /* Breadcrumb */
  .breadcrumb {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    font-style: italic;
    margin-bottom: 40px;
  }
  .breadcrumb a {
    color: var(--color-text-dim);
    text-decoration: none;
  }
  .breadcrumb a:hover { color: var(--color-text); }

  /* Type label */
  .type-label {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .marcador {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--mint);
    border-radius: 1px;
    flex-shrink: 0;
  }
  .tag {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mint);
  }

  /* Hero */
  .hero { margin-bottom: 56px; }

  h1 {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-2xl);
    font-weight: 400;
    color: var(--color-text-bright);
    margin-bottom: 16px;
    line-height: 1.1;
  }

  .subtitulo {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-md);
    line-height: 1.5;
    color: #A8A5A0;
  }

  /* Sections */
  section { margin-bottom: 64px; }

  h2 {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin-bottom: 24px;
  }

  p {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    line-height: 2;
    color: var(--color-text);
    margin-bottom: 1.4em;
  }
  p:last-child { margin-bottom: 0; }

  /* Manifiesto */
  .manifiesto { margin-bottom: 64px; }

  /* Para quién */
  .contraste {
    color: #A8A5A0;
    margin-top: 0.4em;
  }

  /* Momentos */
  .momentos-lista {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .momento {
    padding-left: 20px;
    border-left: 2px solid var(--color-border);
  }
  .momento-titulo {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    font-style: italic;
    color: var(--color-text-bright);
    margin-bottom: 6px;
  }
  .momento-desc {
    color: var(--color-text-dim);
    line-height: 1.8;
    margin-bottom: 0;
  }

  /* Formatos */
  .formatos-lista {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .formato {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .formato:first-child { border-top: 1px solid var(--color-border); }
  .formato-nombre {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-base);
    color: var(--color-text-bright);
  }
  .formato-desc {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-sm);
    color: var(--color-text-dim);
    line-height: 1.8;
    margin-bottom: 0;
  }

  /* CTA */
  .entrada p { margin-bottom: 28px; }
  .cta {
    display: inline-block;
    padding: 14px 28px;
    background: var(--coral);
    color: #1C1B18;
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: 2px;
  }
  .cta:hover { opacity: 0.88; }
</style>
