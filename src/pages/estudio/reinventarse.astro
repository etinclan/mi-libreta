---
import Base from '../../layouts/Base.astro';

const semanas = [
  { label: "Semana 1", titulo: "[SEMANA_1_TITULO]", desc: "[SEMANA_1_DESC]" },
  { label: "Semana 2", titulo: "[SEMANA_2_TITULO]", desc: "[SEMANA_2_DESC]" },
  { label: "Semana 3", titulo: "[SEMANA_3_TITULO]", desc: "[SEMANA_3_DESC]" },
  { label: "Semana 4", titulo: "[SEMANA_4_TITULO]", desc: "[SEMANA_4_DESC]" },
];

const metodo = [
  { label: "Reshufle",           href: "/notas/reshufle" },
  { label: "Las cuatro posturas ante la IA", href: "/notas/cuatro-posturas" },
  { label: "Las cuatro mecánicas de reinvención", href: "/notas/cuatro-mecanicas" },
];

const casos = [
  { label: "Caso A", desc: "[CASO_A_DESC]", atribucion: "[CASO_A_ATRIBUCION]" },
  { label: "Caso B", desc: "[CASO_B_DESC]", atribucion: "[CASO_B_ATRIBUCION]" },
  { label: "Caso C", desc: "[CASO_C_DESC]", atribucion: "[CASO_C_ATRIBUCION]" },
];

const cohortes = [
  {
    fecha: "[FECHA_COHORTE_1]",
    estado: "Abierta",
    estadoColor: "#5EECC5",
    titulo: "[COHORTE_1_TITULO]",
    meta: "[COHORTE_1_META — horario, plazas]",
  },
  {
    fecha: "[FECHA_COHORTE_2]",
    estado: "Lista de espera",
    estadoColor: "#FF8F6B",
    titulo: "[COHORTE_2_TITULO]",
    meta: "[COHORTE_2_META — horario, plazas]",
  },
];
---

<Base title="Reinventarse · Estudio · Eduardo Toledo">
  <div class="reinventarse">

    <p class="breadcrumb"><a href="/estudio">← Estudio</a></p>

    <div class="type-label">
      <span class="marcador-h" aria-hidden="true"></span>
      <span class="tag">Itinerario individual</span>
    </div>

    <header class="hero">
      <h1>Reinventarse</h1>
      <p class="subtitulo"><em>[SUBTITULO_HERO]</em></p>
    </header>

    <section class="manifiesto">
      <p>[MANIFIESTO_P1]</p>
      <p>[MANIFIESTO_P2]</p>
      <p>[MANIFIESTO_P3]</p>
    </section>

    <section class="quien">
      <h2>Quién entra aquí</h2>
      <p>[QUIEN_DESC]</p>
      <p class="contraste"><em>[QUIEN_CONTRASTE — "No es para X. Es para Y."]</em></p>
    </section>

    <section class="semanas">
      <h2>Cuatro semanas, cuatro movimientos</h2>
      <div class="semanas-lista">
        {semanas.map(s => (
          <div class="semana">
            <span class="semana-label">{s.label}</span>
            <p class="semana-titulo"><em>{s.titulo}</em></p>
            <p class="semana-desc">{s.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="metodo">
      <h2>El método, en abierto</h2>
      <p>[METODO_DESC]</p>
      <ul class="metodo-links">
        {metodo.map(m => (
          <li><a href={m.href}>{m.label} →</a></li>
        ))}
      </ul>
    </section>

    <section class="casos">
      <h2>Tres trayectorias</h2>
      <div class="casos-lista">
        {casos.map(c => (
          <div class="caso">
            <span class="caso-label"><em>{c.label}</em></span>
            <p class="caso-desc">{c.desc}</p>
            <p class="caso-atribucion"><em>{c.atribucion}</em></p>
          </div>
        ))}
      </div>
    </section>

    <section class="cohortes">
      <div class="cohortes-header">
        <span class="marcador-h" aria-hidden="true"></span>
        <span class="tag">Próximas cohortes</span>
      </div>
      <div class="cohortes-lista">
        {cohortes.map(c => (
          <div class="cohorte">
            <div class="cohorte-meta-top">
              <span class="cohorte-fecha"><em>{c.fecha}</em></span>
              <span class="cohorte-estado">
                <span class="dot" style={`background:${c.estadoColor}`}></span>
                {c.estado}
              </span>
            </div>
            <p class="cohorte-titulo">{c.titulo}</p>
            <p class="cohorte-meta">{c.meta}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="inversion">
      <h2>Inversión</h2>
      <p class="precio">[PRECIO]</p>
      <p>[INVERSION_DESC — qué incluye]</p>
    </section>

    <section class="entrada">
      <h2>Cómo entrar</h2>
      <p>[COMO_ENTRAR_DESC]</p>
      <a href="mailto:edutoledo@gmail.com" class="cta">Reservar plaza →</a>
    </section>

  </div>
</Base>

<style>
  :root {
    --mint:  #5EECC5;
    --coral: #FF8F6B;
  }

  .reinventarse { max-width: 72ch; }

  /* Breadcrumb */
  .breadcrumb {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    font-style: italic;
    margin-bottom: 40px;
  }
  .breadcrumb a { color: var(--color-text-dim); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-text); }

  /* Type label (horizontal) */
  .type-label,
  .cohortes-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .marcador-h {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--mint);
    border-radius: 1px;
    flex-shrink: 0;
  }
  .tag {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mint);
  }

  /* Hero */
  .hero { margin-bottom: 56px; }

  h1 {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-2xl);
    font-weight: 400;
    color: var(--color-text-bright);
    margin-bottom: 16px;
    line-height: 1.1;
  }

  .subtitulo {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-md);
    line-height: 1.5;
    color: #A8A5A0;
  }

  /* Sections */
  section { margin-bottom: 72px; }

  h2 {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin-bottom: 24px;
  }

  p {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    line-height: 2;
    color: var(--color-text);
    margin-bottom: 1.4em;
  }
  p:last-child { margin-bottom: 0; }

  .manifiesto { margin-bottom: 64px; }

  /* Quién */
  .contraste { color: #A8A5A0; }

  /* Semanas */
  .semanas-lista {
    display: flex;
    flex-direction: column;
    counter-reset: semana;
  }
  .semana {
    display: grid;
    grid-template-columns: 80px 1fr;
    column-gap: 24px;
    row-gap: 4px;
    padding: 24px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .semana:first-child { border-top: 1px solid var(--color-border); }
  .semana-label {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    color: var(--color-text-dim);
    padding-top: 4px;
    grid-row: 1 / 3;
    align-self: start;
  }
  .semana-titulo {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    font-style: italic;
    color: var(--color-text-bright);
    margin-bottom: 0;
    line-height: 1.6;
  }
  .semana-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-dim);
    line-height: 1.8;
    margin-bottom: 0;
  }

  /* Método */
  .metodo-links {
    list-style: none;
    padding: 0;
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .metodo-links a {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    color: var(--color-accent);
    text-decoration: none;
  }
  .metodo-links a:hover { text-decoration: underline; }

  /* Casos */
  .casos-lista {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .caso {
    padding-left: 20px;
    border-left: 2px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .caso-label {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-sm);
    font-style: italic;
    color: var(--coral);
  }
  .caso-desc {
    color: var(--color-text);
    margin-bottom: 0;
  }
  .caso-atribucion {
    font-size: var(--font-size-sm);
    color: var(--color-text-dim);
    margin-bottom: 0;
    line-height: 1.6;
  }

  /* Cohortes */
  .cohortes-lista {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .cohorte {
    padding: 20px 0;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .cohorte:first-child { border-top: 1px solid var(--color-border); }
  .cohorte-meta-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .cohorte-fecha {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-sm);
    font-style: italic;
    color: var(--color-text-dim);
  }
  .cohorte-estado {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    color: var(--color-text-dim);
    white-space: nowrap;
  }
  .dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .cohorte-titulo {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-base);
    color: var(--color-text-bright);
    margin-bottom: 0;
    line-height: 1.4;
  }
  .cohorte-meta {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    color: var(--color-text-dim);
    margin-bottom: 0;
    line-height: 1.6;
  }

  /* Inversión */
  .precio {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-xl);
    color: var(--color-text-bright);
    margin-bottom: 16px;
    line-height: 1;
  }

  /* CTA */
  .entrada p { margin-bottom: 28px; }
  .cta {
    display: inline-block;
    padding: 14px 28px;
    background: var(--coral);
    color: #1C1B18;
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: 2px;
  }
  .cta:hover { opacity: 0.88; }
</style>
