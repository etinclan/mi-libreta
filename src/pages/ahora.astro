---
import Base from '../layouts/Base.astro';
import Antetitulo from '../components/Antetitulo.astro';

const ultimaActualizacion = "mayo 2026";

const trabajando = [
  "[Proyecto o trabajo principal — ej: Preparando conferencia sobre IA y trabajo para X]",
  "[Segundo proyecto activo]",
  "[Tercer proyecto activo]",
];

const aprendiendo = [
  "[Libro, curso o idea — ej: Leyendo The Coming Wave de Mustafa Suleyman]",
  "[Otra cosa que estás explorando]",
];

const viviendo = "[Ciudad, país — ej: Entre Ciudad de México y Madrid]";

const noHaciendo = "[Algo que dejaste ir / declinaste — da carácter y honestidad]";
---

<Base title="Ahora · Eduardo Toledo">
  <div class="ahora">

    <header>
      <Antetitulo texto="AHORA" />
      <h1>Ahora</h1>
      <p class="intro">
        Una instantánea de lo que ocupa mi atención en este momento.<br/>
        Inspirado en el <a href="https://nownownow.com/about" target="_blank" rel="noopener">movimiento /now</a> de Derek Sivers.
      </p>
      <p class="fecha">Última actualización: {ultimaActualizacion}</p>
    </header>

    <section>
      <h2>Trabajando en</h2>
      <ul>
        {trabajando.map(item => <li>{item}</li>)}
      </ul>
    </section>

    <section>
      <h2>Aprendiendo</h2>
      <ul>
        {aprendiendo.map(item => <li>{item}</li>)}
      </ul>
    </section>

    <section>
      <h2>Viviendo en</h2>
      <p class="lugar">{viviendo}</p>
    </section>

    {noHaciendo && (
      <section>
        <h2>Lo que no estoy haciendo</h2>
        <p class="nodoing">{noHaciendo}</p>
      </section>
    )}

  </div>
</Base>

<style>
  .ahora { max-width: 72ch; }

  header { margin-bottom: 64px; }
  h1 {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-2xl);
    font-weight: 500;
    font-variation-settings: 'SOFT' 30, 'WONK' 1;
    color: var(--etcom-lapis-noche);
    margin-bottom: 20px;
  }
  .intro {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-md);
    font-style: italic;
    line-height: 1.5;
    color: var(--etcom-humo);
    margin-bottom: 12px;
  }
  .intro a {
    color: var(--etcom-lapis);
    text-decoration: underline;
    text-decoration-color: var(--etcom-oro);
    text-underline-offset: 3px;
  }
  .intro a:hover { color: var(--etcom-lapis-vivo); }
  .fecha {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--etcom-humo);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  section { margin-bottom: 56px; }
  h2 {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--etcom-lapis-noche);
    margin-bottom: 20px;
  }

  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  li {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    line-height: 1.8;
    color: var(--etcom-lapis-noche);
    padding-left: 20px;
    border-left: 3px solid var(--etcom-oro);
  }

  .lugar {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-md);
    font-variation-settings: 'SOFT' 30, 'WONK' 1;
    font-style: italic;
    color: var(--etcom-lapis);
  }
  .nodoing {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    line-height: 1.8;
    color: var(--etcom-humo);
    font-style: italic;
  }
</style>
