---
import Base from '../layouts/Base.astro';

const facts = [
  { num: "[FACT_NUM_1]", label: "años de experiencia" },
  { num: "[FACT_NUM_2]", label: "programas diseñados" },
  { num: "[FACT_NUM_3]", label: "directivos formados" },
  { num: "[FACT_NUM_4]", label: "sectores trabajados" },
];

const formatos = [
  {
    label: "[FORMATO_1_LABEL]",
    titulo: "[FORMATO_1_TITULO]",
    desc: "[FORMATO_1_DESC — 2-3 líneas describiendo este formato de colaboración, qué incluye, qué produce, para qué tipo de organización encaja mejor.]",
    duracion: "[DURACION_1]",
    modalidad: "[PRESENCIAL / ONLINE / HÍBRIDO]",
    facturacion: "[FACTURACION_1 — ej: por proyecto / retainer / por jornada]",
  },
  {
    label: "[FORMATO_2_LABEL]",
    titulo: "[FORMATO_2_TITULO]",
    desc: "[FORMATO_2_DESC — 2-3 líneas describiendo este formato de colaboración, qué incluye, qué produce, para qué tipo de organización encaja mejor.]",
    duracion: "[DURACION_2]",
    modalidad: "[PRESENCIAL / ONLINE / HÍBRIDO]",
    facturacion: "[FACTURACION_2]",
  },
  {
    label: "[FORMATO_3_LABEL]",
    titulo: "[FORMATO_3_TITULO]",
    desc: "[FORMATO_3_DESC — 2-3 líneas describiendo este formato de colaboración, qué incluye, qué produce, para qué tipo de organización encaja mejor.]",
    duracion: "[DURACION_3]",
    modalidad: "[PRESENCIAL / ONLINE / HÍBRIDO]",
    facturacion: "[FACTURACION_3]",
  },
];

const casos = [
  {
    sector: "[CASO_1_SECTOR]",
    meta: "[CASO_1_TAMANO] · [CASO_1_ANO]",
    titulo: "[CASO_1_TITULO]",
    p1: "[CASO_1_CONTEXTO_P1 — qué reto tenía la organización, por qué acudieron, qué momento vivían.]",
    p2: "[CASO_1_CONTEXTO_P2 — cómo se diseñó la intervención, qué metodología se aplicó, quién participó.]",
    resultados: [
      "[CASO_1_RESULTADO_1]",
      "[CASO_1_RESULTADO_2]",
      "[CASO_1_RESULTADO_3]",
    ],
    cita: "[CASO_1_CITA — frase directa del cliente o participante]",
    atribucion: "[CASO_1_CARGO], [CASO_1_ORGANIZACION]",
  },
  {
    sector: "[CASO_2_SECTOR]",
    meta: "[CASO_2_TAMANO] · [CASO_2_ANO]",
    titulo: "[CASO_2_TITULO]",
    p1: "[CASO_2_CONTEXTO_P1]",
    p2: "[CASO_2_CONTEXTO_P2]",
    resultados: [
      "[CASO_2_RESULTADO_1]",
      "[CASO_2_RESULTADO_2]",
      "[CASO_2_RESULTADO_3]",
    ],
    cita: "[CASO_2_CITA]",
    atribucion: "[CASO_2_CARGO], [CASO_2_ORGANIZACION]",
  },
  {
    sector: "[CASO_3_SECTOR]",
    meta: "[CASO_3_TAMANO] · [CASO_3_ANO]",
    titulo: "[CASO_3_TITULO]",
    p1: "[CASO_3_CONTEXTO_P1]",
    p2: "[CASO_3_CONTEXTO_P2]",
    resultados: [
      "[CASO_3_RESULTADO_1]",
      "[CASO_3_RESULTADO_2]",
      "[CASO_3_RESULTADO_3]",
    ],
    cita: "[CASO_3_CITA]",
    atribucion: "[CASO_3_CARGO], [CASO_3_ORGANIZACION]",
  },
];

const pasos = [
  { n: "01", titulo: "[PASO_1_TITULO]", desc: "[PASO_1_DESC — 1-2 líneas describiendo esta fase del proceso de trabajo.]" },
  { n: "02", titulo: "[PASO_2_TITULO]", desc: "[PASO_2_DESC]" },
  { n: "03", titulo: "[PASO_3_TITULO]", desc: "[PASO_3_DESC]" },
  { n: "04", titulo: "[PASO_4_TITULO]", desc: "[PASO_4_DESC]" },
  { n: "05", titulo: "[PASO_5_TITULO]", desc: "[PASO_5_DESC]" },
];

const credenciales = [
  "[CREDENCIAL_1 — ej: Profesor, Master in Digital Project Management, IEBS]",
  "[CREDENCIAL_2]",
  "[CREDENCIAL_3]",
  "[CREDENCIAL_4]",
];

const apariciones = [
  { evento: "[EVENTO_1]", medio: "[MEDIO_1]" },
  { evento: "[EVENTO_2]", medio: "[MEDIO_2]" },
  { evento: "[EVENTO_3]", medio: "[MEDIO_3]" },
  { evento: "[EVENTO_4]", medio: "[MEDIO_4]" },
  { evento: "[EVENTO_5]", medio: "[MEDIO_5]" },
  { evento: "[EVENTO_6]", medio: "[MEDIO_6]" },
];

const faqs = [
  {
    pregunta: "[FAQ_1_PREGUNTA — ej: ¿Trabajáis con empresas de cualquier tamaño?]",
    respuesta: "[FAQ_1_RESPUESTA]",
  },
  {
    pregunta: "[FAQ_PRECIO — ej: ¿Cuál es el coste de un programa?]",
    respuesta: "[FAQ_PRECIO_RESPUESTA]",
  },
  {
    pregunta: "[FAQ_3_PREGUNTA]",
    respuesta: "[FAQ_3_RESPUESTA]",
  },
  {
    pregunta: "[FAQ_4_PREGUNTA]",
    respuesta: "[FAQ_4_RESPUESTA]",
  },
];
---

<Base title="Programas para organizaciones · Eduardo Toledo">
<div class="org">

  <!-- HERO -->
  <header class="hero">
    <p class="type-label">Programas para organizaciones</p>
    <h1>[HERO_TITULO — título grande, impacto máximo, 5-8 palabras]</h1>
    <p class="subtitulo"><em>[HERO_SUBTITULO — una línea italic que prometa el resultado, no el servicio]</em></p>
  </header>

  <!-- INTRO + FACTS -->
  <section class="intro-section">
    <div class="manifiesto">
      <p>[INTRO_P1 — primer párrafo. Por qué las organizaciones necesitan este trabajo ahora. El diagnóstico del momento.]</p>
      <p>[INTRO_P2 — segundo párrafo. Qué hace diferente este enfoque respecto a la formación corporativa estándar.]</p>
      <p>[INTRO_P3 — tercer párrafo. La promesa: qué consiguen las organizaciones que trabajan contigo.]</p>
    </div>
    <div class="fact-bar">
      {facts.map(f => (
        <div class="fact">
          <span class="fact-num">{f.num}</span>
          <span class="fact-label">{f.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- FORMATOS -->
  <section class="formatos-section">
    <h2>Tres formatos de colaboración</h2>
    <div class="formatos">
      {formatos.map(f => (
        <div class="formato">
          <p class="formato-label"><em>{f.label}</em></p>
          <h3>{f.titulo}</h3>
          <p class="formato-desc">{f.desc}</p>
          <div class="meta-row">
            <span>{f.duracion}</span>
            <span class="sep">·</span>
            <span>{f.modalidad}</span>
            <span class="sep">·</span>
            <span>{f.facturacion}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CASOS -->
  <section class="casos-section">
    <h2>Casos recientes</h2>
    <div class="casos">
      {casos.map(c => (
        <div class="caso">
          <div class="caso-header">
            <span class="caso-sector"><em>{c.sector}</em></span>
            <span class="caso-meta">{c.meta}</span>
          </div>
          <h3 class="caso-titulo">{c.titulo}</h3>
          <p>{c.p1}</p>
          <p>{c.p2}</p>
          <div class="resultados">
            <ul>
              {c.resultados.map(r => <li>{r}</li>)}
            </ul>
          </div>
          <blockquote class="caso-cita">
            <p>"{c.cita}"</p>
            <cite>{c.atribucion}</cite>
          </blockquote>
        </div>
      ))}
    </div>
  </section>

  <!-- PROCESO -->
  <section class="proceso-section">
    <h2>Cómo trabajamos</h2>
    <ol class="pasos">
      {pasos.map(p => (
        <li class="paso">
          <span class="paso-num"><em>{p.n}</em></span>
          <div class="paso-body">
            <h3>{p.titulo}</h3>
            <p>{p.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- BIO PROFESIONAL -->
  <section class="bio-section">
    <h2>Sobre mí, en clave profesional</h2>
    <div class="bio-inner">
      <div class="avatar">[AVATAR]</div>
      <div class="bio-texto">
        <p>[BIO_P1 — párrafo profesional, no personal. Qué haces, desde cuándo, con qué tipo de organizaciones.]</p>
        <p>[BIO_P2 — segundo párrafo. Tu enfoque, tu metodología, qué te hace diferente como facilitador/consultor.]</p>
        <ul class="credenciales">
          {credenciales.map(c => <li>{c}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- APARICIONES -->
  <section class="apariciones-section">
    <h2>Apariciones recientes</h2>
    <ul class="apariciones">
      {apariciones.map(a => (
        <li>
          <span class="ap-evento">{a.evento}</span>
          <span class="ap-medio"><em>{a.medio}</em></span>
        </li>
      ))}
    </ul>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <h2>Preguntas habituales</h2>
    <div class="faqs">
      {faqs.map(f => (
        <details class="faq">
          <summary><em>{f.pregunta}</em></summary>
          <p>{f.respuesta}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- FORMULARIO -->
  <section class="contacto-section">
    <h2>Conversemos</h2>
    <p class="contacto-intro">[CONTACTO_INTRO — línea breve invitando a dar el primer paso. Sin presión.]</p>
    <form class="formulario" action="https://formspree.io/f/[FORMSPREE_ID]" method="POST">
      <div class="form-row">
        <div class="field">
          <label for="nombre">Nombre</label>
          <input type="text" id="nombre" name="nombre" placeholder="Tu nombre" required />
        </div>
        <div class="field">
          <label for="rol">Rol</label>
          <input type="text" id="rol" name="rol" placeholder="Tu cargo o función" required />
        </div>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="organizacion">Organización</label>
          <input type="text" id="organizacion" name="organizacion" placeholder="Nombre de la empresa o institución" required />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="tu@email.com" required />
        </div>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="tamano">Tamaño de organización</label>
          <select id="tamano" name="tamano">
            <option value="">Selecciona una opción</option>
            <option>Menos de 50 personas</option>
            <option>50–250 personas</option>
            <option>250–1.000 personas</option>
            <option>Más de 1.000 personas</option>
          </select>
        </div>
        <div class="field">
          <label for="formato">Formato que te interesa</label>
          <select id="formato" name="formato">
            <option value="">Selecciona una opción</option>
            <option>[FORMATO_1_TITULO]</option>
            <option>[FORMATO_2_TITULO]</option>
            <option>[FORMATO_3_TITULO]</option>
            <option>Aún no lo sé, quiero explorar</option>
          </select>
        </div>
      </div>
      <div class="field field-full">
        <label for="contexto">Contexto</label>
        <textarea id="contexto" name="contexto" rows="4" placeholder="Cuéntame brevemente qué está pasando en tu organización y qué te trae aquí."></textarea>
      </div>
      <div class="form-footer">
        <button type="submit" class="boton-enviar">Enviar →</button>
        <p class="privacidad"><em>Tus datos se usan exclusivamente para responder a tu consulta. Sin newsletter automática, sin cesión a terceros.</em></p>
      </div>
    </form>
  </section>

  <!-- FOOTER LEGAL -->
  <footer class="footer-legal">
    <div class="col">
      <p class="col-titulo">Razón social</p>
      <p>[RAZON_SOCIAL]<br/>[CIF_NIF]<br/>[DIRECCION_FISCAL]</p>
    </div>
    <div class="col">
      <p class="col-titulo">Contacto profesional</p>
      <p><a href="mailto:edutoledo@gmail.com">edutoledo@gmail.com</a><br/>[TELEFONO_OPCIONAL]</p>
    </div>
    <div class="col">
      <p class="col-titulo">Privacidad y datos</p>
      <p>[POLITICA_PRIVACIDAD_BREVE — ej: "Los datos facilitados se tratan conforme al RGPD. Responsable: Eduardo Toledo. Finalidad: gestión de consultas comerciales."]</p>
    </div>
  </footer>

</div>
</Base>

<style>
  /* ─── Variables locales ─── */
  .org {
    --coral: #FF8F6B;
    --mint:  #5EECC5;
    max-width: 860px;
  }

  /* ─── Hero ─── */
  .hero { margin-bottom: 80px; }
  .type-label {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--coral);
    margin-bottom: 20px;
  }
  h1 {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-3xl);
    font-weight: 400;
    line-height: 1.05;
    color: var(--color-text-bright);
    margin-bottom: 20px;
  }
  .subtitulo {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-md);
    line-height: 1.5;
    color: #A8A5A0;
  }

  /* ─── Secciones ─── */
  section { margin-bottom: 88px; }
  h2 {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin-bottom: 40px;
  }
  p {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    line-height: 2;
    color: var(--color-text);
    margin-bottom: 1.4em;
  }
  p:last-child { margin-bottom: 0; }

  /* ─── Intro + Fact bar ─── */
  .manifiesto { max-width: 68ch; margin-bottom: 56px; }
  .fact-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
  }
  .fact {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 28px 20px;
    background: #1F1E1B;
    gap: 8px;
    text-align: center;
  }
  .fact:not(:last-child) { border-right: 1px solid var(--color-border); }
  .fact-num {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-2xl);
    color: var(--color-text-bright);
    line-height: 1;
  }
  .fact-label {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    color: var(--color-text-dim);
    letter-spacing: 0.04em;
  }

  /* ─── Formatos ─── */
  .formatos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
  }
  .formato {
    padding: 32px 28px;
    background: #1F1E1B;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .formato:not(:last-child) { border-right: 1px solid var(--color-border); }
  .formato-label {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-sm);
    color: var(--coral);
    line-height: 1;
    margin: 0;
  }
  .formato h3 {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-md);
    font-weight: 400;
    color: var(--color-text-bright);
    line-height: 1.2;
  }
  .formato-desc {
    font-size: var(--font-size-sm) !important;
    line-height: 1.7 !important;
    color: var(--color-text-dim) !important;
    flex: 1;
    margin: 0 !important;
  }
  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    color: #5A5855;
    margin-top: 8px;
  }
  .meta-row .sep { color: #3A3835; }

  /* ─── Casos ─── */
  .casos { display: flex; flex-direction: column; gap: 64px; }
  .caso { padding-bottom: 64px; border-bottom: 1px solid var(--color-border); }
  .caso:last-child { border-bottom: none; padding-bottom: 0; }
  .caso-header {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 16px;
  }
  .caso-sector {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-sm);
    color: var(--coral);
  }
  .caso-meta {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    color: var(--color-text-dim);
  }
  .caso-titulo {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-lg);
    font-weight: 400;
    color: var(--color-text-bright);
    line-height: 1.2;
    margin-bottom: 24px;
  }
  .resultados {
    border-left: 3px solid var(--mint);
    padding-left: 24px;
    margin: 28px 0;
  }
  .resultados ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .resultados li {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    line-height: 1.6;
    color: var(--color-text);
    padding-left: 20px;
    position: relative;
  }
  .resultados li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--coral);
    font-family: var(--font-sans);
  }
  .caso-cita {
    margin-top: 28px;
    padding: 24px 28px;
    background: #1F1E1B;
    border-radius: 6px;
    border: 1px solid var(--color-border);
  }
  .caso-cita p {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    font-style: italic;
    line-height: 1.7;
    color: var(--color-text-bright);
    margin-bottom: 12px;
  }
  .caso-cita cite {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-style: normal;
    font-weight: 300;
    color: var(--color-text-dim);
  }

  /* ─── Proceso ─── */
  .pasos {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .paso {
    display: flex;
    gap: 32px;
    padding: 32px 0;
    border-bottom: 1px solid var(--color-border);
    align-items: flex-start;
  }
  .paso:first-child { border-top: 1px solid var(--color-border); }
  .paso-num {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-xl);
    font-style: italic;
    color: var(--coral);
    line-height: 1;
    min-width: 2.5ch;
    opacity: 0.7;
  }
  .paso-body h3 {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-md);
    font-weight: 400;
    color: var(--color-text-bright);
    margin-bottom: 8px;
    line-height: 1.2;
  }
  .paso-body p {
    font-size: var(--font-size-sm) !important;
    line-height: 1.7 !important;
    color: var(--color-text-dim) !important;
    margin: 0 !important;
  }

  /* ─── Bio ─── */
  .bio-inner {
    display: flex;
    gap: 40px;
    align-items: flex-start;
  }
  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: var(--color-border);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    color: var(--color-text-dim);
    text-align: center;
  }
  .credenciales {
    list-style: none;
    padding: 0;
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .credenciales li {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: 300;
    color: var(--color-text-dim);
    padding-left: 16px;
    position: relative;
  }
  .credenciales li::before {
    content: "·";
    position: absolute;
    left: 0;
    color: var(--coral);
    font-weight: 700;
  }

  /* ─── Apariciones ─── */
  .apariciones {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }
  .apariciones li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .apariciones li:nth-child(odd) { padding-right: 32px; }
  .ap-evento {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    color: var(--color-text);
    line-height: 1.3;
  }
  .ap-medio {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    color: var(--color-text-dim);
  }

  /* ─── FAQ ─── */
  .faqs { display: flex; flex-direction: column; }
  .faq {
    border-bottom: 1px solid var(--color-border);
  }
  .faq:first-child { border-top: 1px solid var(--color-border); }
  .faq summary {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    color: var(--color-text-bright);
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
