---
import Base from '../layouts/Base.astro';

// ⚠️  DATOS ILUSTRATIVOS — sustituir por cifras reales antes de publicar
const facts = [
  { num: "12",    label: "años trabajando con organizaciones en transformación" },
  { num: "+40",   label: "programas ejecutivos diseñados a medida" },
  { num: "+1.800",label: "directivos y mandos formados" },
  { num: "8",     label: "sectores cubiertos en España y Latinoamérica" },
];

const formatos = [
  {
    label: "Conferencia ejecutiva",
    titulo: "Asomarse al nuevo juego",
    desc: "Sesión de 90 minutos para Comité de Dirección, Consejo o jornada de líderes. Cartografía del terreno, las cuatro posturas estratégicas ante la IA y las preguntas que un líder debería estar haciéndose. Pensada para abrir la conversación al máximo nivel.",
    meta: "90 minutos · presencial u online · español o inglés · facturación corporativa",
  },
  {
    label: "Programa formativo",
    titulo: "Reinventarse en equipo",
    desc: "Itinerario de 4 a 8 semanas para grupos de 12 a 40 personas. Reposicionamiento profesional aplicado a roles concretos de la organización. Cohortes mixtas o por función. Combina sesiones en vivo, materiales propios y trabajo aplicado al puesto de cada participante.",
    meta: "4–8 semanas · cohortes de 12 a 40 · sesiones en vivo + trabajo aplicado · entregables individuales",
  },
  {
    label: "Programa estratégico",
    titulo: "Recartografiar la organización",
    desc: "Programa de 6 a 12 meses para acompañar al Comité de Dirección y a la primera línea ejecutiva en el rediseño estratégico ante la IA. Incluye diagnóstico inicial de cadena de valor, talleres de comité, formación de líderes intermedios y acompañamiento operativo. Diseñado a medida.",
    meta: "6–12 meses · diagnóstico + talleres + formación + acompañamiento · entregables a medida",
  },
];

// ⚠️  CASOS ILUSTRATIVOS — sustituir por casos reales con permiso de cliente antes de publicar
const casos = [
  {
    sector: "Banca privada española",
    meta: "600 empleados · 2025",
    titulo: "Reposicionamiento de la red de banqueros senior ante la asesoría asistida por IA",
    p1: "La organización detectó que el 40% de sus interacciones con cliente premium podía ser asistido por IA. La pregunta no era qué automatizar, sino qué pasaba con el rol del banquero senior cuando el cliente llegaba más informado y la herramienta resolvía gran parte del análisis técnico.",
    p2: 'Diseñamos un programa de 6 meses combinando talleres de Comité, reposicionamiento del rol de banquero y formación a 80 mandos intermedios. El programa redefinió la propuesta de valor del banquero como “consejero de criterio” y rediseñó los rituales de relación con el cliente.',
    resultados: [
      "NPS del segmento premium subió 14 puntos",
      "Retención de banqueros senior pasó del 78% al 91%",
      "Ratio de cross-selling en clientes asistidos por IA creció 23%",
    ],
    cita: "Edu no nos enseñó IA. Nos ayudó a redefinir el oficio de banquero en un terreno donde la IA ya estaba dentro. Eso es lo que ningún otro proveedor nos estaba ofreciendo.",
    atribucion: "Directora de Banca Privada · disponible para referencia",
  },
  {
    sector: "Despacho legal multinacional",
    meta: "1.200 abogados · 2024–2025",
    titulo: "Programa de reinvención para asociados y of counsels ante la automatización del trabajo legal",
    p1: "El despacho estaba viendo cómo herramientas de IA específicas para derecho reducían entre un 40% y un 70% el tiempo de tareas tradicionalmente asignadas a asociados. La pregunta del Comité Ejecutivo era cómo evitar que esto descapitalizara la cantera de futuros socios.",
    p2: "El programa formó a 240 asociados durante 8 semanas en reposicionamiento de su rol hacia tareas de criterio jurídico, relación con cliente y diseño de estrategia procesal. En paralelo, trabajamos con 18 of counsels en reformulación de su propuesta personal.",
    resultados: [
      "240 asociados formados con plan individual de reposicionamiento",
      "Reducción del 35% en el churn voluntario entre asociados senior",
      "Tres nuevas líneas de servicio diseñadas por participantes del programa",
    ],
    cita: "Tras este programa, dejamos de ver la IA como una amenaza al modelo de carrera y empezamos a verla como una palanca para revalorizar el oficio jurídico. Es un cambio cultural enorme.",
    atribucion: "Socio responsable de Talento",
  },
  {
    sector: "Compañía energética cotizada",
    meta: "3.400 empleados · 2024",
    titulo: "Recartografía de la función de Personas y Cultura ante la nueva relación humano-máquina",
    p1: "La compañía estaba lanzando una transformación masiva con IA generativa en operaciones, atención al cliente y back-office. La Dirección de Personas necesitaba redefinir el modelo de competencias, los itinerarios de carrera y el discurso interno para acompañar al cambio sin destruir la cultura.",
    p2: "Diseñamos un programa estratégico de 9 meses con tres capas: diagnóstico de impacto en 22 familias profesionales, talleres con el equipo directivo de Personas, y formación a 60 HRBPs para que pudieran sostener la conversación con sus áreas.",
    resultados: [
      "Nuevo marco de competencias aprobado e implementado",
      "60 HRBPs capacitados para sostener conversaciones de reposicionamiento",
      "Reducción del 50% en escalamientos a Personas por inseguridad ante IA",
    ],
    cita: "[Cita pendiente con permiso del cliente]",
    atribucion: "Directora de Personas y Cultura",
  },
];

const pasos = [
  {
    n: "01",
    titulo: "Conversación inicial",
    desc: "Una primera llamada de 45–60 minutos para entender qué necesitas, qué momento atraviesa la organización y si encajamos. Sin coste, sin compromiso, con confidencialidad.",
  },
  {
    n: "02",
    titulo: "Propuesta a medida",
    desc: "En un plazo de 7 a 10 días, te envío una propuesta formal con objetivos, alcance, metodología, entregables, calendario y honorarios. Propuesta firmable, con condiciones claras de facturación.",
  },
  {
    n: "03",
    titulo: "Diagnóstico ligero",
    desc: "Una vez firmado el contrato, dos semanas de inmersión inicial: entrevistas con sponsors, revisión de materiales internos, validación del diseño. Permite calibrar el programa antes de arrancar.",
  },
  {
    n: "04",
    titulo: "Ejecución",
    desc: "Despliegue del programa diseñado, con revisiones periódicas con el sponsor y ajustes basados en evidencia de campo. Documentación de aprendizajes para tu organización al cierre.",
  },
  {
    n: "05",
    titulo: "Cierre y transferencia",
    desc: "Informe final con resultados, recomendaciones para sostener el cambio sin mí y, si tiene sentido, plan de continuidad ligero a 6–12 meses.",
  },
];

const credenciales = [
  "Profesor de Diseño Organizacional en el Master in Digital Project Management de IEBS",
  "Colaborador habitual con escuelas de negocio y centros de innovación corporativa en España y Latinoamérica",
  "Autor de la newsletter mensual sobre agencia humana en la era de la IA",
  "Creador de los marcos Reshufle, las cuatro posturas ante la IA y las cuatro mecánicas de reinvención",
  "Publicaciones y entrevistas en medios de management, podcasts profesionales y prensa especializada",
];

// ⚠️  APARICIONES ILUSTRATIVAS — sustituir por las reales antes de publicar
const apariciones = [
  { evento: "Ponencia inaugural Foro de Innovación en Banca · 2026",     medio: "" },
  { evento: "Entrevista",                                                  medio: "Sintetia · febrero 2026" },
  { evento: "Conferencia HR Innovation Summit · Madrid 2025",             medio: "" },
  { evento: "Podcast Tres en Raya con Marc Vidal · 2025",                 medio: "" },
  { evento: "Mesa redonda Mobile World Congress · 2025",                  medio: "" },
  { evento: "Artículo",                                                    medio: "Harvard Deusto Business Review · número 332" },
  { evento: "Conferencia South Summit · 2024",                            medio: "" },
  { evento: "Podcast Itnig Podcast · capítulo 412",                       medio: "" },
];

const faqs = [
  {
    pregunta: "¿Cuánto cuesta un programa?",
    respuesta: "Los honorarios varían en función del formato, alcance y duración. Como referencia: una conferencia ejecutiva está entre 4.000 € y 9.000 €. Un programa formativo de 4–8 semanas para 12–40 personas, entre 30.000 € y 90.000 €. Un programa estratégico de 6–12 meses, desde 120.000 €. Todas las propuestas se cierran con honorarios fijos, sin sorpresas a mitad de ejecución.",
  },
  {
    pregunta: "¿Trabajas con un equipo o solo?",
    respuesta: "Para conferencias y programas pequeños, trabajo solo. Para programas estratégicos largos, colaboro con una red estable de profesionales especializados —facilitación, datos, diseño instruccional— que se incorporan según necesidad. En cada propuesta detallo quién hace qué.",
  },
  {
    pregunta: "¿Cómo se factura?",
    respuesta: "Facturación profesional sujeta a IVA, con condiciones habituales de contratación corporativa. Calendarios de pago flexibles: típicamente 30% al inicio, hitos intermedios y cierre. Acepto contratos marco y procesos de homologación de proveedores.",
  },
  {
    pregunta: "¿Cubres aspectos técnicos de IA o solo organizativos?",
    respuesta: "Mi competencia central es el cruce estrategia–aprendizaje–cultura. No soy ingeniero de IA. En programas donde se necesita componente técnico, trabajo con partners especializados o me coordino con tus equipos técnicos.",
  },
  {
    pregunta: "¿Atendéis fuera de España?",
    respuesta: "Sí. He trabajado con organizaciones en España y Latinoamérica. Programas en español o inglés. Disponible para sesiones presenciales con previsión razonable.",
  },
  {
    pregunta: "¿Tenemos garantía de confidencialidad?",
    respuesta: "Sí. Firmamos NDA antes de cualquier intercambio sensible. Todos los casos publicados en esta web están anonimizados o publicados con permiso explícito del cliente.",
  },
];
---

<Base title="Programas para organizaciones · Eduardo Toledo">
<div class="org">

  <!-- HERO -->
  <header class="hero">
    <p class="type-label">Programas para organizaciones</p>
    <h1>Recartografiar la organización ante la IA</h1>
    <p class="subtitulo"><em>Programas a medida para que tu empresa no entre en piloto automático algorítmico.</em></p>
  </header>

  <!-- INTRO + FACTS -->
  <section class="intro-section">
    <div class="manifiesto">
      <p>Las organizaciones que mejor van a salir de los próximos cinco años no son las que adopten más IA, sino las que conserven y fortalezcan su capacidad de decidir, crear y aprender con criterio propio cuando la IA ya está dentro.</p>
      <p>Eso pide algo distinto a un curso de prompts o a una jornada de sensibilización. Pide recartografiar: revisar dónde está creando valor tu organización hoy, dónde va a desplazarse ese valor, y qué tipo de cultura, prácticas y liderazgo necesita para sostener autoría humana en cada función crítica.</p>
      <p>Llevo años trabajando con organizaciones en momentos de transformación. Lo que ofrezco no es un catálogo de cursos — es un programa diseñado contigo, ejecutado con tu equipo, con resultados medibles.</p>
    </div>
    <div class="fact-bar">
      {facts.map(f => (
        <div class="fact">
          <span class="fact-num">{f.num}</span>
          <span class="fact-label">{f.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- FORMATOS -->
  <section class="formatos-section">
    <h2>Tres formatos de colaboración</h2>
    <div class="formatos">
      {formatos.map(f => (
        <div class="formato">
          <p class="formato-label"><em>{f.label}</em></p>
          <h3>{f.titulo}</h3>
          <p class="formato-desc">{f.desc}</p>
          <p class="meta-row">{f.meta}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CASOS -->
  <section class="casos-section">
    <h2>Casos recientes</h2>
    <div class="casos">
      {casos.map(c => (
        <div class="caso">
          <div class="caso-header">
            <span class="caso-sector"><em>{c.sector}</em></span>
            <span class="caso-meta">{c.meta}</span>
          </div>
          <h3 class="caso-titulo">{c.titulo}</h3>
          <p>{c.p1}</p>
          <p>{c.p2}</p>
          <div class="resultados">
            <ul>
              {c.resultados.map(r => <li>{r}</li>)}
            </ul>
          </div>
          <blockquote class="caso-cita">
            <p>"{c.cita}"</p>
            <cite>{c.atribucion}</cite>
          </blockquote>
        </div>
      ))}
    </div>
  </section>

  <!-- PROCESO -->
  <section class="proceso-section">
    <h2>Cómo trabajamos</h2>
    <ol class="pasos">
      {pasos.map(p => (
        <li class="paso">
          <span class="paso-num"><em>{p.n}</em></span>
          <div class="paso-body">
            <h3>{p.titulo}</h3>
            <p>{p.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- BIO PROFESIONAL -->
  <section class="bio-section">
    <h2>Sobre mí, en clave profesional</h2>
    <div class="bio-inner">
      <div class="avatar" aria-hidden="true">ET</div>
      <div class="bio-texto">
        <p>Llevo años diseñando programas formativos y consultorías para organizaciones en momentos de transformación. Mi especialidad es el cruce entre estrategia, aprendizaje organizativo y la nueva relación humano-máquina. Trabajo desde un encuadre propio que llamo cartografía de lo emergente: ayudo a organizaciones a leer el terreno que cambia y a repensar prácticas, roles y cultura en consecuencia.</p>
        <ul class="credenciales">
          {credenciales.map(c => <li>{c}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- APARICIONES -->
  <section class="apariciones-section">
    <h2>Apariciones recientes</h2>
    <ul class="apariciones">
      {apariciones.map(a => (
        <li>
          <span class="ap-evento">{a.evento}</span>
          {a.medio && <span class="ap-medio"><em>{a.medio}</em></span>}
        </li>
      ))}
    </ul>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <h2>Preguntas habituales</h2>
    <div class="faqs">
      {faqs.map(f => (
        <details class="faq">
          <summary><em>{f.pregunta}</em></summary>
          <p>{f.respuesta}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- FORMULARIO -->
  <section class="contacto-section">
    <h2>Conversemos</h2>
    <p class="contacto-intro">Si crees que podemos trabajar juntos, escríbeme con un poco de contexto. Te responderé en un plazo de 48 horas laborables.</p>
    <form class="formulario" action="https://formspree.io/f/[FORMSPREE_ID]" method="POST">
      <input type="hidden" name="_to" value="edutoledo@gmail.com" />
      <input type="hidden" name="_subject" value="Consulta desde eduardotoledo.com/organizaciones" />
      <div class="form-row">
        <div class="field">
          <label for="nombre">Nombre y apellidos</label>
          <input type="text" id="nombre" name="nombre" placeholder="Tu nombre completo" required />
        </div>
        <div class="field">
          <label for="rol">Rol</label>
          <input type="text" id="rol" name="rol" placeholder="Directora de Personas, CEO…" required />
        </div>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="organizacion">Organización</label>
          <input type="text" id="organizacion" name="organizacion" placeholder="Nombre de la empresa o institución" required />
        </div>
        <div class="field">
          <label for="email">Email corporativo</label>
          <input type="email" id="email" name="email" placeholder="tu@empresa.com" required />
        </div>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="tamano">Tamaño de la organización</label>
          <select id="tamano" name="tamano">
            <option value="">Selecciona una opción</option>
            <option>Hasta 100 empleados</option>
            <option>100–500</option>
            <option>500–2.000</option>
            <option>2.000–10.000</option>
            <option>Más de 10.000</option>
          </select>
        </div>
        <div class="field">
          <label for="formato">Formato que te interesa</label>
          <select id="formato" name="formato">
            <option value="">Selecciona una opción</option>
            <option>Conferencia ejecutiva</option>
            <option>Programa formativo (4–8 semanas)</option>
            <option>Programa estratégico (6–12 meses)</option>
            <option>Aún por decidir</option>
          </select>
        </div>
      </div>
      <div class="field field-full">
        <label for="contexto">¿Qué te ronda por la cabeza?</label>
        <textarea id="contexto" name="contexto" rows="5" placeholder="Una idea del momento que atraviesa la organización, qué intentas resolver, qué presupuesto orientativo manejas y para cuándo lo necesitas. Cuanto más concreto, mejor."></textarea>
      </div>
      <div class="form-footer">
        <button type="submit" class="boton-enviar">Enviar →</button>
        <p class="privacidad"><em>Responderé personalmente en menos de 48h laborables. Toda la conversación es confidencial.</em></p>
      </div>
    </form>
  </section>

  <!-- FOOTER LEGAL -->
  <footer class="footer-legal">
    <div class="col">
      <p class="col-titulo">Razón social</p>
      <p>Eduardo Toledo Inclán<br/>NIF disponible bajo solicitud<br/>Madrid, España</p>
    </div>
    <div class="col">
      <p class="col-titulo">Contacto profesional</p>
      <p>
        <a href="mailto:edutoledo@gmail.com">edutoledo@gmail.com</a><br/>
        <a href="https://www.linkedin.com/in/eduardotoledoinclan/" target="_blank" rel="noopener">LinkedIn</a>
      </p>
    </div>
    <div class="col">
      <p class="col-titulo">Privacidad y datos</p>
      <p>
        Cumplimiento RGPD<br/>
        <a href="/privacidad">Política de privacidad</a><br/>
        <a href="/aviso-legal">Aviso legal</a>
      </p>
    </div>
  </footer>

</div>
</Base>

<style>
  .org {
    --coral: #FF8F6B;
    --mint:  #5EECC5;
    max-width: 860px;
  }

  /* ─── Hero ─── */
  .hero { margin-bottom: 80px; }
  .type-label {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--coral);
    margin-bottom: 20px;
  }
  h1 {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-3xl);
    font-weight: 400;
    line-height: 1.05;
    color: var(--color-text-bright);
    margin-bottom: 20px;
  }
  .subtitulo {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-md);
    line-height: 1.5;
    color: #A8A5A0;
  }

  /* ─── Secciones ─── */
  section { margin-bottom: 88px; }
  h2 {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin-bottom: 40px;
  }
  p {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    line-height: 2;
    color: var(--color-text);
    margin-bottom: 1.4em;
  }
  p:last-child { margin-bottom: 0; }

  /* ─── Fact bar ─── */
  .manifiesto { max-width: 68ch; margin-bottom: 56px; }
  .fact-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
  }
  .fact {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 28px 16px;
    background: #1F1E1B;
    gap: 8px;
    text-align: center;
  }
  .fact:not(:last-child) { border-right: 1px solid var(--color-border); }
  .fact-num {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-2xl);
    color: var(--color-text-bright);
    line-height: 1;
  }
  .fact-label {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    color: var(--color-text-dim);
    line-height: 1.4;
  }

  /* ─── Formatos ─── */
  .formatos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
  }
  .formato {
    padding: 32px 28px;
    background: #1F1E1B;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .formato:not(:last-child) { border-right: 1px solid var(--color-border); }
  .formato-label {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-sm);
    color: var(--coral);
    line-height: 1;
    margin: 0;
  }
  .formato h3 {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-md);
    font-weight: 400;
    color: var(--color-text-bright);
    line-height: 1.2;
  }
  .formato-desc {
    font-size: var(--font-size-sm) !important;
    line-height: 1.75 !important;
    color: var(--color-text) !important;
    flex: 1;
    margin: 0 !important;
  }
  .meta-row {
    font-family: var(--font-sans) !important;
    font-size: var(--font-size-xs) !important;
    font-weight: 300 !important;
    line-height: 1.6 !important;
    color: #5A5855 !important;
    margin: 0 !important;
    border-top: 1px solid var(--color-border);
    padding-top: 14px;
  }

  /* ─── Casos ─── */
  .casos { display: flex; flex-direction: column; gap: 64px; }
  .caso { padding-bottom: 64px; border-bottom: 1px solid var(--color-border); }
  .caso:last-child { border-bottom: none; padding-bottom: 0; }
  .caso-header {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 16px;
  }
  .caso-sector {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-sm);
    color: var(--coral);
  }
  .caso-meta {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    color: var(--color-text-dim);
  }
  .caso-titulo {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-lg);
    font-weight: 400;
    color: var(--color-text-bright);
    line-height: 1.2;
    margin-bottom: 24px;
  }
  .resultados {
    border-left: 3px solid var(--mint);
    padding-left: 24px;
    margin: 28px 0;
  }
  .resultados ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
