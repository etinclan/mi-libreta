---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const notas = await getCollection('notas');
const ensayos = await getCollection('ensayos').catch(() => []);
const todo = [...notas, ...ensayos];

const territorios = [
  { slug: 'aprender-ensenar', label: 'Aprender y enseñar' },
  { slug: 'pensar',           label: 'Pensar' },
  { slug: 'crear',            label: 'Crear' },
  { slug: 'comunicarse',      label: 'Comunicarse' },
  { slug: 'relacionarnos',    label: 'Relacionarnos' },
  { slug: 'trabajar',         label: 'Trabajar' },
];

function countByTerritorio(slug: string) {
  return todo.filter(e => (e.data.tags ?? []).includes(slug)).length;
}
---

<Base title="Mi Libreta · Eduardo Toledo">
  <div class="jardin">

    <header>
      <h1>Mi Libreta</h1>
      <p class="desc">Una colección de notas, ensayos e ideas creciendo lentamente.</p>
    </header>

    <section class="territorios-section">
      <h2>Escribo sobre</h2>
      <div class="territorios">
        {territorios.map(t => (
          <a href={`/jardin/${t.slug}`} class="territorio">
            <span class="nombre">{t.label}</span>
            <span class="count">{countByTerritorio(t.slug)}</span>
          </a>
        ))}
      </div>
    </section>

    <section>
      <h2>Todas las notas</h2>
      <ul>
        {notas.map(nota => (
          <li>
            <a href={`/notas/${nota.id}`}>{nota.data.title}</a>
            <span class={`stage ${nota.data.stage}`}>{nota.data.stage}</span>
          </li>
        ))}
        {notas.length === 0 && <li class="vacio">Aún no hay notas.</li>}
      </ul>
    </section>

  </div>
</Base>

<style>
  .jardin { max-width: 760px; }

  header { margin-bottom: 64px; }
  h1 {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-2xl);
    font-weight: 400;
    color: var(--color-text-bright);
    margin-bottom: 12px;
  }
  .desc {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: 300;
    color: var(--color-text-dim);
  }

  h2 {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin-bottom: 24px;
  }

  /* Territorios */
  .territorios-section { margin-bottom: 72px; }
  .territorios {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .territorio {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 22px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .territorio:hover {
    border-color: var(--color-accent);
    background: #1F1E1B;
  }
  .nombre {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    font-weight: 400;
    color: var(--color-text);
  }
  .territorio:hover .nombre { color: var(--color-text-bright); }
  .count {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    color: #3A3835;
  }
  .territorio:hover .count { color: var(--color-text-dim); }

  /* Lista de notas */
  section { margin-bottom: 56px; }
  ul { list-style: none; padding: 0; }
  li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--color-border);
  }
  li:first-child { border-top: 1px solid var(--color-border); }
  li a {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-md);
    color: var(--color-text);
    text-decoration: none;
    flex: 1;
  }
  li a:hover { color: var(--color-accent); }
  .stage {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 3px;
    background: var(--color-border);
    color: var(--color-text-dim);
  }
  .vacio {
    font-size: var(--font-size-sm);
    font-weight: 300;
    color: #3A3835;
    border: none !important;
    padding-top: 8px !important;
  }

  @media (max-width: 600px) {
    .territorios { grid-template-columns: repeat(2, 1fr); }
  }
</style>
