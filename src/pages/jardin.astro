---
import Base from '../layouts/Base.astro';
import Antetitulo from '../components/Antetitulo.astro';
import { getCollection } from 'astro:content';

const notas = await getCollection('notas');
const ensayos = await getCollection('ensayos').catch(() => []);
const todo = [...notas, ...ensayos];

const territorios = [
  { slug: 'aprender-ensenar', label: 'Aprender y enseñar' },
  { slug: 'pensar',           label: 'Pensar' },
  { slug: 'crear',            label: 'Crear' },
  { slug: 'comunicarse',      label: 'Comunicarse' },
  { slug: 'relacionarnos',    label: 'Relacionarnos' },
  { slug: 'trabajar',         label: 'Trabajar' },
];

const stageLabels: Record<string, string> = {
  intuicion: 'Intuición',
  emergente: 'Borrador',
  maduro:    'Ensayo',
};

function countByTerritorio(slug: string) {
  return todo.filter(e => (e.data.tags ?? []).includes(slug)).length;
}
---

<Base title="La Libreta · Eduardo Toledo">
  <div class="jardin">

    <header>
      <Antetitulo texto="LA LIBRETA" />
      <h1>La Libreta</h1>
      <p class="subtitulo"><em>Un cuaderno de campo sobre cómo fortalecer la agencia humana en la era de la IA.</em></p>
      <div class="manifiesto">
        <p>Esto no es un blog. Es un jardín — un sitio donde las ideas crecen a su ritmo, en estados distintos de madurez. Algunas son intuiciones a medio cocinar. Otras llevan años destilándose. Verás las dos cosas, etiquetadas con honestidad. Prefiero mostrarte el levantamiento del mapa que solo el mapa terminado.</p>
        <p>Las notas se organizan en seis territorios — seis frentes de la misma pregunta: cómo seguir eligiendo cuando las máquinas piensan por nosotros. Puedes recorrerlas por territorio o ver todas en orden cronológico más abajo.</p>
      </div>
      <div class="leyenda">
        <span class="leyenda-titulo">Los estados</span>
        <ul>
          <li><span class="badge intuicion">Intuición</span> una idea recién planteada, todavía cruda.</li>
          <li><span class="badge emergente">Borrador</span> un argumento articulado, abierto a revisión.</li>
          <li><span class="badge maduro">Ensayo</span> un texto destilado, asentado.</li>
        </ul>
      </div>
    </header>

    <section class="territorios-section">
      <h2>Escribo sobre</h2>
      <div class="territorios">
        {territorios.map(t => (
          <a href={`/jardin/${t.slug}`} class="territorio">
            <span class="nombre">{t.label}</span>
            <span class="count">{countByTerritorio(t.slug)}</span>
          </a>
        ))}
      </div>
    </section>

    <section>
      <h2>Todas las notas</h2>
      <ul class="notas-lista">
        {notas.map(nota => (
          <li>
            <a href={`/notas/${nota.id}`}>{nota.data.title}</a>
            <span class={`badge ${nota.data.stage}`}>{stageLabels[nota.data.stage]}</span>
          </li>
        ))}
        {notas.length === 0 && <li class="vacio">Aún no hay notas.</li>}
      </ul>
    </section>

  </div>
</Base>

<style>
  .jardin { max-width: 760px; }

  /* Header */
  header { margin-bottom: 72px; }
  h1 {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-2xl);
    font-weight: 500;
    font-variation-settings: 'SOFT' 30, 'WONK' 1;
    color: var(--etcom-lapis-noche);
    margin-bottom: 16px;
  }
  .subtitulo {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-md);
    font-style: italic;
    line-height: 1.4;
    color: var(--etcom-humo);
    margin-bottom: 32px;
  }

  .manifiesto {
    margin-bottom: 40px;
    max-width: 68ch;
  }
  .manifiesto p {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    line-height: 1.8;
    color: var(--etcom-lapis-noche);
    margin-bottom: 1.2em;
  }
  .manifiesto p:last-child { margin-bottom: 0; }

  /* Leyenda */
  .leyenda {
    padding: 24px 28px;
    border: 1px solid var(--etcom-oro);
    border-left: 3px solid var(--etcom-oro);
    border-radius: 4px;
    background: var(--etcom-vitela-claro);
    max-width: 52ch;
  }
  .leyenda-titulo {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--etcom-lapis);
    margin-bottom: 14px;
  }
  .leyenda ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .leyenda li {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-sm);
    color: var(--etcom-humo);
    display: flex;
    align-items: center;
    gap: 12px;
    line-height: 1.4;
  }

  /* Badges — compartido entre leyenda y lista */
  .badge {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 3px;
    white-space: nowrap;
    background: var(--etcom-humo-claro);
    color: var(--etcom-vitela);
  }
  .badge.maduro    { background: var(--mora, #3B1E54);  color: var(--pergamino, #F6F1E8); }
  .badge.emergente { background: var(--rojo, #D94F2A);  color: var(--pergamino, #F6F1E8); }
  .badge.intuicion { background: var(--niebla, #E7E3F2); color: var(--mora, #3B1E54); }

  h2 {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--etcom-lapis-noche);
    margin-bottom: 24px;
  }

  /* Territorios */
  .territorios-section { margin-bottom: 72px; }
  .territorios {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .territorio {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 22px;
    border: 1px solid var(--etcom-oro-suave);
    border-top: 3px solid var(--etcom-oro);
    border-radius: 4px;
    background: var(--etcom-vitela-claro);
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .territorio:hover {
    border-color: var(--etcom-lapis);
    border-top-color: var(--etcom-lapis);
    box-shadow: 0 4px 12px rgba(38,53,140,0.08);
  }
  .nombre {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    color: var(--etcom-lapis-noche);
  }
  .territorio:hover .nombre { color: var(--etcom-lapis-vivo); }
  .count {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--etcom-humo-claro);
    letter-spacing: 0.06em;
  }
  .territorio:hover .count { color: var(--etcom-humo); }

  /* Lista de notas */
  section { margin-bottom: 56px; }
  .notas-lista { list-style: none; padding: 0; }
  .notas-lista li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--etcom-oro-suave);
  }
  .notas-lista li:first-child { border-top: 1px solid var(--etcom-oro); }
  .notas-lista a {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-md);
    color: var(--etcom-lapis-noche);
    text-decoration: none;
    flex: 1;
  }
  .notas-lista a:hover { color: var(--etcom-lapis-vivo); }
  .vacio {
    font-size: var(--font-size-sm);
    font-style: italic;
    color: var(--etcom-humo);
    border: none !important;
    padding-top: 8px !important;
  }

  @media (max-width: 600px) {
    .territorios { grid-template-columns: repeat(2, 1fr); }
  }
</style>
