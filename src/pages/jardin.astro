---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const notas = await getCollection('notas');
const ensayos = await getCollection('ensayos').catch(() => []);
const todo = [...notas, ...ensayos];

const territorios = [
  { slug: 'aprender-ensenar', label: 'Aprender y enseñar' },
  { slug: 'pensar',           label: 'Pensar' },
  { slug: 'crear',            label: 'Crear' },
  { slug: 'comunicarse',      label: 'Comunicarse' },
  { slug: 'relacionarnos',    label: 'Relacionarnos' },
  { slug: 'trabajar',         label: 'Trabajar' },
];

const stageLabels: Record<string, string> = {
  intuicion: 'Intuición',
  emergente: 'Borrador',
  maduro:    'Ensayo',
};

function countByTerritorio(slug: string) {
  return todo.filter(e => (e.data.tags ?? []).includes(slug)).length;
}
---

<Base title="Mi Libreta · Eduardo Toledo">
  <div class="jardin">

    <header>
      <h1>Mi Libreta</h1>
      <p class="subtitulo"><em>Un cuaderno de campo sobre cómo fortalecer la agencia humana en la era de la IA.</em></p>
      <div class="manifiesto">
        <p>Esto no es un blog. Es un jardín — un sitio donde las ideas crecen a su ritmo, en estados distintos de madurez. Algunas son intuiciones a medio cocinar. Otras llevan años destilándose. Verás las dos cosas, etiquetadas con honestidad. Prefiero mostrarte el levantamiento del mapa que solo el mapa terminado.</p>
        <p>Las notas se organizan en seis territorios — seis frentes de la misma pregunta: cómo seguir eligiendo cuando las máquinas piensan por nosotros. Puedes recorrerlas por territorio o ver todas en orden cronológico más abajo.</p>
      </div>
      <div class="leyenda">
        <span class="leyenda-titulo">Los estados</span>
        <ul>
          <li><span class="badge intuicion">Intuición</span> una idea recién planteada, todavía cruda.</li>
          <li><span class="badge emergente">Borrador</span> un argumento articulado, abierto a revisión.</li>
          <li><span class="badge maduro">Ensayo</span> un texto destilado, asentado.</li>
        </ul>
      </div>
    </header>

    <section class="territorios-section">
      <h2>Escribo sobre</h2>
      <div class="territorios">
        {territorios.map(t => (
          <a href={`/jardin/${t.slug}`} class="territorio">
            <span class="nombre">{t.label}</span>
            <span class="count">{countByTerritorio(t.slug)}</span>
          </a>
        ))}
      </div>
    </section>

    <section>
      <h2>Todas las notas</h2>
      <ul class="notas-lista">
        {notas.map(nota => (
          <li>
            <a href={`/notas/${nota.id}`}>{nota.data.title}</a>
            <span class={`badge ${nota.data.stage}`}>{stageLabels[nota.data.stage]}</span>
          </li>
        ))}
        {notas.length === 0 && <li class="vacio">Aún no hay notas.</li>}
      </ul>
    </section>

  </div>
</Base>

<style>
  .jardin { max-width: 760px; }

  /* Header */
  header { margin-bottom: 72px; }
  h1 {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-2xl);
    font-weight: 400;
    color: var(--color-text-bright);
    margin-bottom: 16px;
  }
  .subtitulo {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-md);
    line-height: 1.4;
    color: #A8A5A0;
    margin-bottom: 32px;
  }
  .subtitulo em { font-style: italic; }

  .manifiesto {
    margin-bottom: 40px;
    max-width: 68ch;
  }
  .manifiesto p {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    line-height: 2;
    color: var(--color-text);
    margin-bottom: 1.2em;
  }
  .manifiesto p:last-child { margin-bottom: 0; }

  /* Leyenda */
  .leyenda {
    padding: 24px 28px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: #1F1E1B;
    max-width: 52ch;
  }
  .leyenda-titulo {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin-bottom: 14px;
  }
  .leyenda ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .leyenda li {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-sm);
    color: var(--color-text-dim);
    display: flex;
    align-items: center;
    gap: 12px;
    line-height: 1.4;
  }

  /* Badges — compartido entre leyenda y lista */
  .badge {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 3px;
    white-space: nowrap;
    background: var(--color-border);
    color: var(--color-text-dim);
  }
  .badge.maduro    { background: #1A2E1A; color: #5C9E5C; }
  .badge.emergente { background: #2A2215; color: #B08A3E; }
  .badge.intuicion { background: var(--color-border); color: var(--color-text-dim); }

  h2 {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin-bottom: 24px;
  }

  /* Territorios */
  .territorios-section { margin-bottom: 72px; }
  .territorios {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .territorio {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 22px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .territorio:hover {
    border-color: var(--color-accent);
    background: #1F1E1B;
  }
  .nombre {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    color: var(--color-text);
  }
  .territorio:hover .nombre { color: var(--color-text-bright); }
  .count {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    color: #3A3835;
  }
  .territorio:hover .count { color: var(--color-text-dim); }

  /* Lista de notas */
  section { margin-bottom: 56px; }
  .notas-lista { list-style: none; padding: 0; }
  .notas-lista li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .notas-lista li:first-child { border-top: 1px solid var(--color-border); }
  .notas-lista a {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-md);
    color: var(--color-text);
    text-decoration: none;
    flex: 1;
  }
  .notas-lista a:hover { color: var(--color-accent); }
  .vacio {
    font-size: var(--font-size-sm);
    color: #3A3835;
    border: none !important;
    padding-top: 8px !important;
  }

  @media (max-width: 600px) {
    .territorios { grid-template-columns: repeat(2, 1fr); }
  }
</style>
