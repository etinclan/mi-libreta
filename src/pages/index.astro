---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const todasLasNotas = await getCollection('notas').catch(() => []);
const notasRecientes = todasLasNotas
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

function fmtDate(d: Date) {
  return d.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base title="Eduardo Toledo — Relevancia profesional y organizacional en la era de la IA">
  <div class="home">

    <!-- 1. HERO -->
    <section class="hero" aria-label="hero">
      <h1>Descubre cómo la IA <em>dará forma</em> a tu profesión, negocio e industria</h1>
      <p class="subtitulo">La IA reescribe las reglas de juego: la ventaja ya no es producir más como en el mundo digital. Deja de ser Old school. Aquí encontrarás cómo seguir siendo relevante cuando la IA reordena el trabajo, el valor y la creación.</p>
      <p class="hub-tagline"><strong>Esta no es la típica página web personal</strong><br/>Es un Hub para aprender a rediseñar la relevancia profesional, creativa y organizacional en una economía impulsada por IA</p>
    </section>

    <!-- 2. MARCOS -->
    <section class="seccion seccion--clara" aria-label="marcos">
      <p class="eyebrow">MARCOS DE TRABAJO</p>
      <h2>Tus mapas para pensar, decidir y trabajar en la era de la IA</h2>
      <p class="seccion-texto">Cuando el sistema cambia, necesitas nuevos marcos para guiarte mejor por la nueva realidad. Toda una colección de mapas de un nuevo territorio, para releer el trabajo, el valor y tu relevancia con las reglas nuevas.</p>
      <a href="/marcos" class="cta-btn">Ver los mapas →</a>
    </section>

    <!-- 3. HERRAMIENTAS -->
    <section class="seccion" aria-label="herramientas">
      <p class="eyebrow">HERRAMIENTAS</p>
      <h2>Herramientas para navegar la ola agéntica y dejar de ir a la deriva</h2>
      <p class="seccion-texto">Diagnósticos, canvas, checklists y prompts para usar y guardar. No para leerme: para que pienses, decidas y trabajes mejor.</p>
      <a href="/herramientas" class="cta-btn">Coge tus herramientas →</a>
    </section>

    <!-- 4. PROGRAMAS -->
    <section class="seccion seccion--clara" aria-label="programas">
      <p class="eyebrow">PROGRAMAS</p>
      <h2>¿Necesitas que te acompañe?</h2>
      <p class="seccion-texto">Programas para rediseñar tu relevancia, la de tu equipo o la de tu marca. Del diagnóstico a la implementación, paso a paso contigo.</p>
      <a href="/programas" class="cta-btn">Cómo trabajamos juntos →</a>
    </section>

    <!-- 5. CUADERNO -->
    <section class="seccion" aria-label="cuaderno">
      <p class="eyebrow">CUADERNO DE VIAJE</p>
      <h2>Mi cuaderno de viaje</h2>
      <p class="seccion-texto">Comparto mis apuntes sobre cómo construir una forma propia de pensar, crear y decidir que no dependa del algoritmo.</p>

      {notasRecientes.length > 0 && (
        <ul class="notas-lista" role="list">
          {notasRecientes.map(nota => (
            <li class="nota-item">
              <a href={`/notas/${nota.id}`} class="nota-link">
                <span class="nota-titulo">{nota.data.title}</span>
                <span class="nota-fecha">{fmtDate(nota.data.date)}</span>
              </a>
            </li>
          ))}
        </ul>
      )}

      <a href="/cuaderno" class="ver-cuaderno">Descubre en qué estoy ahora →</a>
    </section>

    <!-- 6. EL GRAN REAJUSTE -->
    <section class="seccion seccion--oscura" aria-label="reframe-game">
      <p class="eyebrow eyebrow--claro">EL GRAN REAJUSTE</p>
      <h2 class="titulo--claro">El gran reajuste — Cómo ser relevante en cuatro pasos</h2>
      <p class="seccion-texto seccion-texto--claro">Un juego para ver quién gana poder cuando la IA reescribe las reglas. La mejor manera de aprender a ganar con las nuevas reglas de la IA, de manera experiencial y totalmente enfocado a la realidad de tu profesión, negocio e industria.</p>
      <a href="/programas" class="cta-btn cta-btn--lima">Es lo que buscaba →</a>
    </section>

  </div>
</Base>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* HERO */
  .hero {
    padding: 80px 0 96px;
    max-width: 760px;
  }

  h1 {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-2xl);
    font-weight: 500;
    line-height: 1.1;
    color: var(--mora);
    margin-bottom: 24px;
  }

  h1 em {
    font-style: italic;
    color: var(--rojo);
  }

  .subtitulo {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    line-height: 1.75;
    color: var(--meta);
    max-width: 62ch;
    margin-bottom: 28px;
  }

  .hub-tagline {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-sm);
    line-height: 1.65;
    color: var(--mora);
    max-width: 58ch;
    padding: 20px 24px;
    border-left: 3px solid var(--rojo);
    background: var(--niebla);
    border-radius: 0 3px 3px 0;
    margin-top: 8px;
  }

  .hub-tagline strong {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mora);
    margin-bottom: 6px;
  }

  /* SECCIONES */
  .seccion {
    padding: 72px 0;
    border-top: 1px solid var(--linea);
  }

  .seccion--clara {
    background: var(--niebla);
    margin-left: -80px;
    margin-right: -80px;
    padding-left: 80px;
    padding-right: 80px;
  }

  .seccion--oscura {
    background: var(--mora);
    margin-left: -80px;
    margin-right: -80px;
    padding-left: 80px;
    padding-right: 80px;
    border-top: none;
  }

  /* EYEBROW */
  .eyebrow {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rojo);
    margin-bottom: 16px;
  }

  .eyebrow--claro {
    color: var(--lima);
  }

  /* H2 */
  h2 {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-lg);
    font-weight: 500;
    line-height: 1.15;
    color: var(--mora);
    margin-bottom: 20px;
    max-width: 680px;
  }

  .titulo--claro {
    color: var(--pergamino);
  }

  /* TEXTO SECCIÓN */
  .seccion-texto {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    line-height: 1.75;
    color: var(--tinta);
    max-width: 58ch;
    margin-bottom: 32px;
  }

  .seccion-texto--claro {
    color: rgba(246, 241, 232, 0.82);
  }

  /* CTA BOTÓN */
  .cta-btn {
    display: inline-block;
    background: var(--rojo);
    color: var(--pergamino);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 14px 28px;
    border-radius: 3px;
    text-decoration: none;
    transition: background 0.15s;
  }

  .cta-btn:hover {
    background: var(--rojo-deep);
  }

  .cta-btn--lima {
    background: var(--lima);
    color: var(--tinta);
  }

  .cta-btn--lima:hover {
    background: #b8f020;
  }

  /* NOTAS LISTA */
  .notas-lista {
    list-style: none;
    padding: 0;
    margin-bottom: 32px;
    max-width: 640px;
  }

  .nota-item {
    border-bottom: 1px solid var(--linea);
  }

  .nota-item:first-child {
    border-top: 1px solid var(--linea);
  }

  .nota-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding: 16px 0;
    text-decoration: none;
  }

  .nota-titulo {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-sm);
    color: var(--mora);
    line-height: 1.4;
    transition: color 0.12s;
  }

  .nota-link:hover .nota-titulo {
    color: var(--rojo);
  }

  .nota-fecha {
    font-family: var(--font-sans);
    font-size: 0.625rem;
    color: var(--meta);
    letter-spacing: 0.06em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* VER CUADERNO */
  .ver-cuaderno {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--mora);
    text-decoration: none;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--mora);
    padding-bottom: 2px;
    transition: color 0.12s, border-color 0.12s;
  }

  .ver-cuaderno:hover {
    color: var(--rojo);
    border-color: var(--rojo);
  }

  /* RESPONSIVE */
  @media (max-width: 767px) {
    .hero {
      padding: 48px 0 64px;
    }

    .seccion--clara,
    .seccion--oscura {
      margin-left: -24px;
      margin-right: -24px;
      padding-left: 24px;
      padding-right: 24px;
    }

    .nota-link {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
