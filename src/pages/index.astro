---
import Base from '../layouts/Base.astro';
import EstadoBadge from '../components/mdx/EstadoBadge.astro';
import { getCollection } from 'astro:content';

const territorios = [
  { nombre: "Aprender y enseñar", slug: "aprender" },
  { nombre: "Pensar",             slug: "pensar" },
  { nombre: "Crear",              slug: "crear" },
  { nombre: "Comunicarse",        slug: "comunicarse" },
  { nombre: "Relacionarnos",      slug: "relacionarnos" },
  { nombre: "Trabajar",           slug: "trabajar" },
];

const stageToEstado: Record<string, 'intuicion' | 'borrador' | 'ensayo'> = {
  intuicion: 'intuicion',
  emergente: 'borrador',
  maduro:    'ensayo',
};

// Libreta: separar por columnas
const todasLasNotas = await getCollection('notas').catch(() => []);
const ordenadas = todasLasNotas.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const ensayos   = ordenadas.filter(n => n.data.stage === 'maduro').slice(0, 4);
const enCoccion = ordenadas.filter(n => n.data.stage === 'intuicion' || n.data.stage === 'emergente').slice(0, 10);

function fmtDate(d: Date) {
  return d.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base title="Eduardo Toledo">
  <div class="home">

    <!-- 1. HERO -->
    <section class="hero">
      <h1>Eduardo ayuda a <em class="coral">fortalecer la agencia humana</em><br>en la Era de la IA</h1>
      <p class="subtitulo"><em>Exploro y comparto lo que descubro sobre cómo la IA cambia nuestra forma de aprender, pensar, crear, comunicarnos, relacionarnos y trabajar</em></p>
      <p class="descripcion">Conecto ideas para crear mis propios mapas, que comparto en artículos y formaciones</p>
    </section>

    <!-- 2. SEIS TERRITORIOS -->
    <section class="territorios-sec">
      <div class="type-label">
        <span class="marcador" aria-hidden="true"></span>
        <span class="tag">De humano para humanos</span>
      </div>
      <h2 class="sec-titulo"><em>La libreta: Lo que voy descubriendo</em></h2>
      <p class="sec-intro">En esta nueva era agéntica, tan incierta y veloz, se precisa otra forma de contar. Mi propuesta: este cuaderno de campo, una colección abierta y viva donde mis ideas crecen a su ritmo. Sin algoritmos, sin SEO. Solo preguntas para reflexionar.
Aquí descubro, investigo, conecto y cartografío cómo la IA está cambiando nuestra vida en estos seis ámbitos:</p>
      <div class="territorios-grid">
        {territorios.map(t => (
          <a href={`/jardin`} class="territorio-item">
            <span class="dot" aria-hidden="true">·</span>
            <span class="territorio-nombre">{t.nombre}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- 3. MAPAS EN PROCESO -->
    <section class="libreta-sec">
      <div class="type-label">
        <span class="marcador" aria-hidden="true"></span>
        <span class="tag">MAPAS EN PROCESO</span>
      </div>
      <h2 class="sec-titulo"><em>Lo que estoy cartografiando</em></h2>

      <div class="libreta-cols">

        <!-- COLUMNA IZQUIERDA — ENSAYOS -->
        <div class="col-ensayos">
          <div class="col-header">
            <span class="col-label">ENSAYOS</span>
            <p class="col-subtitulo"><em>Ideas asentadas. Para leer con tiempo.</em></p>
          </div>

          {ensayos.length === 0 ? (
            <p class="placeholder-texto">Los primeros ensayos están en preparación.</p>
          ) : (
            <div class={`ensayos-grid ensayos-grid--${Math.min(ensayos.length, 2)}`}>
              {ensayos.map((nota, i) => (
                <a href={`/notas/${nota.id}`} class="ensayo-card">
                  <div class="ensayo-imagen">
                    <span class="ensayo-numero">0{i + 1}</span>
                  </div>
                  <div class="ensayo-body">
                    <EstadoBadge estado="ensayo" />
                    <p class="ensayo-titulo">{nota.data.title}</p>
                    {nota.data.description && (
                      <p class="ensayo-extracto">{nota.data.description}</p>
                    )}
                    <span class="ensayo-fecha">{fmtDate(nota.data.date)}</span>
                  </div>
                </a>
              ))}
            </div>
          )}

          <a href="/jardin?estado=ensayo" class="ver-enlace">Ver todos los ensayos →</a>
        </div>

        <!-- COLUMNA DERECHA — EN COCCIÓN -->
        <div class="col-coccion">
          <div class="col-header">
            <span class="col-label">EN COCCIÓN</span>
            <p class="col-subtitulo"><em>Intuiciones y borradores. Lo que estoy pensando ahora, sin haberlo resuelto del todo.</em></p>
          </div>

          {enCoccion.length === 0 ? (
            <p class="placeholder-texto">Empieza a llegar lo recién pensado.</p>
          ) : (
            <ul class="coccion-lista">
              {enCoccion.map(nota => (
                <li class="coccion-item">
                  <a href={`/notas/${nota.id}`} class="coccion-link">
                    <span class="coccion-punto" aria-hidden="true">·</span>
                    <span class="coccion-body">
                      <EstadoBadge estado={stageToEstado[nota.data.stage] ?? 'intuicion'} />
                      <span class="coccion-titulo">{nota.data.title}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )}

          <a href="/jardin" class="ver-enlace">Ver toda la libreta →</a>
        </div>

      </div>
    </section>

    <!-- 4. LA NEWSLETTER -->
    <section class="newsletter-sec">
      <div class="type-label">
        <span class="marcador" aria-hidden="true"></span>
        <span class="tag">La Newsletter</span>
      </div>
      <h2 class="sec-titulo"><em>Cartas desde el nuevo juego</em></h2>
      <p class="sec-intro">Cada mes envío una carta larga a quienes prefieren entender antes de reaccionar. Análisis sectoriales sobre cómo queda cada profesión ante las nuevas reglas del juego de la IA, ensayos asentados y cartas más íntimas sobre la agencia humana. Sin algoritmo, sin urgencia, sin clickbait. Solo un correo al mes que merezca la pena abrir.
[Suscribirse →]</p>
      <a href="https://eduardotoledo.substack.com/subscribe" target="_blank" rel="noopener noreferrer" class="cta-coral">Suscribirse →</a>
    </section>

    <!-- 5. CONMIGO TRABAJAN -->
    <section class="trabajo-sec">
      <div class="type-label">
        <span class="marcador" aria-hidden="true"></span>
        <span class="tag">CONMIGO TRABAJAN</span>
      </div>
      <h2 class="sec-titulo">Cuando el mapa entra en <em class="coral">juego</em></h2>
      <div class="trabajo-cols">
        <a href="/personas" class="trabajo-col">
          <span class="trabajo-quien">PROFESIONALES</span>
          <p class="trabajo-desc">Para profesionales que no quieren otro curso de herramientas. Cohortes pequeñas e itinerarios individuales para descubrir dónde sigue estando tu valor — y reposicionarte antes de que el sistema lo haga por ti.</p>
          <span class="trabajo-link">Ver formaciones →</span>
        </a>
        <a href="/organizaciones" class="trabajo-col">
          <span class="trabajo-quien">ORGANIZACIONES</span>
          <p class="trabajo-desc">Para comités y equipos que entienden que la IA no se decide en el departamento de IT. Conferencias ejecutivas, formaciones a medida y programas estratégicos para leer cómo cambian las reglas del juego en tu sector y reposicionar la organización con criterio.</p>
          <span class="trabajo-link">Ver propuesta B2B →</span>
        </a>
      </div>
    </section>

  </div>
</Base>

<style>
  :root {
    --mint:  #5EECC5;
    --coral: #FF8F6B;
  }

  .home {
    display: flex;
    flex-direction: column;
    gap: 96px;
  }

  /* Shared type-label */
  .type-label {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .marcador {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--mint);
    border-radius: 1px;
    flex-shrink: 0;
  }
  .tag {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mint);
  }

  /* Shared section title */
  .sec-titulo {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-lg);
    font-weight: 400;
    font-style: italic;
    color: var(--color-text-bright);
    line-height: 1.2;
    margin-bottom: 20px;
  }

  /* Shared intro paragraph */
  .sec-intro {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    line-height: 1.9;
    color: var(--color-text);
    max-width: 60ch;
    margin-bottom: 36px;
  }

  /* ── 1. HERO ────────────────────────────────── */
  .hero { max-width: 820px; }

  h1 {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-2xl);
    font-weight: 400;
    line-height: 1.1;
    color: var(--color-text-bright);
    margin-bottom: 20px;
  }
  .coral {
    font-style: italic;
    color: var(--coral);
  }
  .subtitulo {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-md);
    font-style: italic;
    line-height: 1.5;
    color: #A8A5A0;
    margin-bottom: 20px;
  }
  .descripcion {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    font-weight: 300;
    color: var(--color-text-dim);
    letter-spacing: 0.02em;
  }

  /* ── 2. TERRITORIOS ─────────────────────────── */
  .territorios-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px 0;
  }
  .territorio-item {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
  }
  .territorio-item:nth-child(-n+3) { border-top: 1px solid var(--color-border); }
  .territorio-item:hover .territorio-nombre { color: var(--color-text-bright); }
  .territorio-item:hover .dot { color: var(--coral); }
  .dot {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    color: #3A3835;
    line-height: 1;
    flex-shrink: 0;
    transition: color 0.15s;
  }
  .territorio-nombre {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-base);
    color: var(--color-text);
    transition: color 0.15s;
  }

  /* ── 3. MAPAS EN PROCESO ────────────────────── */
  .libreta-cols {
    display: grid;
    grid-template-columns: 62% 1fr;
    gap: 64px;
    align-items: start;
  }

  /* Cabeceras de columna */
  .col-header {
    margin-bottom: 28px;
  }
  .col-label {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--coral);
    display: block;
    margin-bottom: 6px;
  }
  .col-subtitulo {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-sm);
    font-style: italic;
    color: var(--etcom-smoke);
    line-height: 1.6;
  }

  /* Enlace inferior de columna */
  .ver-enlace {
    display: inline-block;
    margin-top: 28px;
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    color: var(--coral);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: opacity 0.15s;
  }
  .ver-enlace:hover { opacity: 0.7; }

  /* Placeholder */
  .placeholder-texto {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-sm);
    font-style: italic;
    color: var(--etcom-smoke);
    opacity: 0.6;
    padding: 32px 0;
  }

  /* ENSAYOS — grid interno */
  .ensayos-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .ensayos-grid--1 { grid-template-columns: 1fr; max-width: 340px; }

  .ensayo-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: #201F1C;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    overflow: hidden;
    transition: border-color 0.15s;
  }
  .ensayo-card:hover { border-color: var(--etcom-smoke); }
  .ensayo-card:hover .ensayo-titulo { color: var(--color-text-bright); }

  .ensayo-imagen {
    height: 120px;
    background: #F5EFE6;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .ensayo-numero {
    font-family: var(--font-serif-display);
    font-size: 3.5rem;
    font-weight: 400;
    color: rgba(28,27,24,0.18);
    line-height: 1;
    user-select: none;
  }

  .ensayo-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .ensayo-titulo {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-base);
    font-weight: 400;
    color: var(--color-text);
    line-height: 1.25;
    transition: color 0.15s;
  }
  .ensayo-extracto {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 300;
    color: var(--etcom-smoke);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ensayo-fecha {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 300;
    color: var(--etcom-smoke);
    opacity: 0.7;
    margin-top: auto;
  }

  /* EN COCCIÓN — lista vertical */
  .coccion-lista {
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .coccion-item {
    border-bottom: 1px solid rgba(107, 101, 96, 0.12);
  }
  .coccion-item:first-child { border-top: 1px solid rgba(107, 101, 96, 0.12); }

  .coccion-link {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 14px 0;
    text-decoration: none;
  }
  .coccion-link:hover .coccion-titulo { color: var(--color-text-bright); }

  .coccion-punto {
    font-size: 1.3rem;
    color: var(--coral);
    line-height: 1;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .coccion-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .coccion-titulo {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-sm);
    font-weight: 400;
    color: var(--color-text);
    line-height: 1.3;
    transition: color 0.15s;
  }

  /* ── 4. NEWSLETTER ──────────────────────────── */
  .cta-coral {
    display: inline-block;
    padding: 14px 32px;
    background: var(--coral);
    color: #1C1B18;
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: 2px;
  }
  .cta-coral:hover { opacity: 0.88; }

  /* ── 5. CONMIGO TRABAJAN ────────────────────── */
  .trabajo-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }
  .trabajo-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px 32px 28px 0;
    border-top: 1px solid var(--color-border);
    text-decoration: none;
  }
  .trabajo-col:last-child { padding-left: 32px; padding-right: 0; border-left: 1px solid var(--color-border); }
  .trabajo-quien {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--etcom-smoke);
  }
  .trabajo-desc {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    line-height: 1.9;
    color: var(--color-text);
  }
  .trabajo-link {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    color: var(--coral);
    letter-spacing: 0.02em;
    margin-top: 8px;
    transition: opacity 0.15s;
  }
  .trabajo-col:hover .trabajo-link { opacity: 0.7; }

  /* ── RESPONSIVE ─────────────────────────────── */
  @media (max-width: 767px) {
    .home { gap: 64px; }
    .territorios-grid { grid-template-columns: 1fr 1fr; }
    .territorio-item:nth-child(-n+3) { border-top: none; }
    .territorio-item:nth-child(-n+2) { border-top: 1px solid var(--color-border); }
    .trabajo-cols { grid-template-columns: 1fr; }
    .trabajo-col:last-child { padding-left: 0; border-left: none; border-top: 1px solid var(--color-border); }

    /* Libreta — apila columnas, ensayos primero */
    .libreta-cols {
      grid-template-columns: 1fr;
      gap: 56px;
    }
    .ensayos-grid {
      grid-template-columns: 1fr;
    }
    .ensayos-grid--1 { max-width: 100%; }
  }
</style>
