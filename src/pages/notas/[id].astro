---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import EstadoBadge from '../../components/mdx/EstadoBadge.astro';
import MetaEntrada from '../../components/mdx/MetaEntrada.astro';
import Audiencia from '../../components/mdx/Audiencia.astro';
import Duda from '../../components/mdx/Duda.astro';
import NotaAlMargen from '../../components/mdx/NotaAlMargen.astro';
import Cita from '../../components/mdx/Cita.astro';
import EntradaRelacionada from '../../components/mdx/EntradaRelacionada.astro';
import Territorios from '../../components/mdx/Territorios.astro';

export async function getStaticPaths() {
  const notas = await getCollection('notas');
  return notas.map(nota => ({
    params: { id: nota.id },
    props: { nota },
  }));
}

const { nota } = Astro.props;
const { Content } = await render(nota);

const stageLabels: Record<string, string> = {
  intuicion: 'Intuición',
  emergente: 'Emergente',
  maduro: 'Maduro',
};

const dateStr = nota.data.date.toLocaleDateString('es-MX', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={`${nota.data.title} · La Libreta`}>
  <article>
    <header>
      <p class="meta">
        <span class={`stage ${nota.data.stage}`}>{stageLabels[nota.data.stage]}</span>
        <span class="date">{dateStr}</span>
      </p>
      <h1>{nota.data.title}</h1>
      {nota.data.tags && (
        <p class="tags">
          {nota.data.tags.map(tag => <span class="tag">#{tag}</span>)}
        </p>
      )}
    </header>
    <div class="body">
      <Content components={{ EstadoBadge, MetaEntrada, Audiencia, Duda, NotaAlMargen, Cita, EntradaRelacionada, Territorios }} />
    </div>
  </article>
</Base>

<style>
  article { max-width: 72ch; }

  header {
    margin-bottom: 56px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--color-border);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }
  .stage {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 3px;
    background: var(--color-border);
    color: var(--color-text-dim);
  }
  .stage.maduro   { background: #1A2E1A; color: #5C9E5C; }
  .stage.emergente { background: #2A2215; color: #B08A3E; }
  .date {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    color: var(--color-text-dim);
  }
  h1 {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-xl);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-text-bright);
    margin-bottom: 20px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .tag {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    color: var(--color-text-dim);
  }

  /* Cuerpo del artículo — igual que ProseWrapper de Maggie */
  .body {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    line-height: 2;
    color: var(--color-text);
  }
  .body :global(h2) {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-xl);
    font-weight: 400;
    color: var(--color-text-bright);
    line-height: 1.2;
    margin: 2.5em 0 0.8em;
  }
  .body :global(h3) {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin: 2em 0 0.8em;
  }
  .body :global(p)  { margin-bottom: 1.5em; }
  .body :global(a)  { color: var(--color-accent); text-decoration: none; }
  .body :global(a:hover) { text-decoration: underline; }
  .body :global(blockquote) {
    text-align: center;
    padding: 2em 0;
    margin: 1.5em 0;
  }
  .body :global(blockquote p) {
    font-size: var(--font-size-lg);
    line-height: 1.4;
    max-width: 28ch;
    margin: 0 auto 1.5em;
    font-style: italic;
    color: #A8A5A0;
  }
  .body :global(code) {
    font-family: monospace;
    font-size: var(--font-size-sm);
    background: var(--color-border);
    padding: 2px 6px;
    border-radius: 3px;
    color: var(--color-text);
  }
  .body :global(ul), .body :global(ol) {
    padding-left: 1.5em;
    margin-bottom: 1.5em;
  }
  .body :global(li) {
    margin-bottom: 0.5em;
    line-height: 2;
  }
</style>
