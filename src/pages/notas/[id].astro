---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notas = await getCollection('notas');
  return notas.map(nota => ({
    params: { id: nota.id },
    props: { nota },
  }));
}

const { nota } = Astro.props;
const { Content } = await render(nota);

const stageLabels: Record<string, string> = {
  intuicion: 'Intuición',
  emergente: 'Emergente',
  maduro: 'Maduro',
};

const dateStr = nota.data.date.toLocaleDateString('es-MX', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={`${nota.data.title} · Mi Libreta`}>
  <article>
    <header>
      <p class="meta">
        <span class={`stage ${nota.data.stage}`}>{stageLabels[nota.data.stage]}</span>
        <span class="date">{dateStr}</span>
      </p>
      <h1>{nota.data.title}</h1>
      {nota.data.tags && (
        <p class="tags">
          {nota.data.tags.map(tag => <span class="tag">#{tag}</span>)}
        </p>
      )}
    </header>
    <div class="body">
      <Content />
    </div>
  </article>
</Base>

<style>
  article { max-width: 720px; }

  header {
    margin-bottom: 56px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--color-border);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }
  .stage {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 3px;
    background: var(--color-border);
    color: var(--color-text-dim);
  }
  .stage.maduro   { background: #1A2E1A; color: #5C9E5C; }
  .stage.emergente { background: #2A2215; color: #B08A3E; }
  .date {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    color: var(--color-text-dim);
  }
  h1 {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-xl);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-text-bright);
    margin-bottom: 20px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .tag {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 300;
    color: var(--color-text-dim);
  }

  /* Cuerpo del artículo */
  .body {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    line-height: 1.85;
    color: var(--color-text);
  }
  .body :global(h2) {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-lg);
    font-weight: 400;
    color: var(--color-text-bright);
    margin: 48px 0 20px;
  }
  .body :global(h3) {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin: 40px 0 16px;
  }
  .body :global(p)  { margin-bottom: 24px; }
  .body :global(a)  { color: var(--color-accent); text-decoration: none; }
  .body :global(a:hover) { text-decoration: underline; }
  .body :global(blockquote) {
    border-left: 2px solid var(--color-accent);
    margin: 32px 0;
    padding-left: 24px;
    color: #A8A5A0;
    font-style: italic;
  }
  .body :global(code) {
    font-family: monospace;
    font-size: var(--font-size-sm);
    background: var(--color-border);
    padding: 2px 6px;
    border-radius: 3px;
    color: var(--color-text);
  }
  .body :global(ul), .body :global(ol) {
    padding-left: 24px;
    margin-bottom: 24px;
  }
  .body :global(li) { margin-bottom: 8px; }
</style>
