---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import EstadoBadge from '../../components/mdx/EstadoBadge.astro';
import MetaEntrada from '../../components/mdx/MetaEntrada.astro';
import Audiencia from '../../components/mdx/Audiencia.astro';
import Duda from '../../components/mdx/Duda.astro';
import NotaAlMargen from '../../components/mdx/NotaAlMargen.astro';
import Cita from '../../components/mdx/Cita.astro';
import EntradaRelacionada from '../../components/mdx/EntradaRelacionada.astro';
import Territorios from '../../components/mdx/Territorios.astro';

export async function getStaticPaths() {
  const notas = await getCollection('notas');
  return notas.map(nota => ({
    params: { id: nota.id },
    props: { nota },
  }));
}

const { nota } = Astro.props;
const { Content } = await render(nota);

const stageLabels: Record<string, string> = {
  intuicion: 'Intuición',
  emergente: 'Emergente',
  maduro: 'Maduro',
};

const dateStr = nota.data.date.toLocaleDateString('es-MX', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={`${nota.data.title} · La Libreta`}>
  <article>
    <header>
      <p class="meta">
        <span class={`stage ${nota.data.stage}`}>{stageLabels[nota.data.stage]}</span>
        <span class="date">{dateStr}</span>
      </p>
      <h1>{nota.data.title}</h1>
      {nota.data.tags && (
        <p class="tags">
          {nota.data.tags.map(tag => <span class="tag">#{tag}</span>)}
        </p>
      )}
    </header>
    <div class="body">
      <Content components={{ EstadoBadge, MetaEntrada, Audiencia, Duda, NotaAlMargen, Cita, EntradaRelacionada, Territorios }} />
    </div>
  </article>
</Base>

<style>
  article { max-width: 72ch; }

  header {
    margin-bottom: 56px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--etcom-oro);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }
  .stage {
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 3px;
    background: var(--etcom-humo-claro);
    color: var(--etcom-vitela);
  }
  .stage.maduro    { background: var(--etcom-lapis); color: var(--etcom-vitela); }
  .stage.emergente { background: var(--etcom-oro); color: var(--etcom-lapis-noche); }
  .date {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--etcom-humo);
  }
  h1 {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-xl);
    font-weight: 500;
    font-variation-settings: 'SOFT' 30, 'WONK' 1;
    line-height: 1.1;
    color: var(--etcom-lapis-noche);
    margin-bottom: 20px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .tag {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: var(--etcom-lapis);
    padding: 2px 8px;
    border: 1px solid var(--etcom-oro);
    border-radius: 3px;
  }

  /* Cuerpo del artículo — igual que ProseWrapper de Maggie */
  .body {
    font-family: var(--font-serif-text);
    font-size: var(--font-size-base);
    line-height: 1.8;
    color: var(--etcom-lapis-noche);
  }
  .body :global(h2) {
    font-family: var(--font-serif-display);
    font-size: var(--font-size-xl);
    font-weight: 500;
    font-variation-settings: 'SOFT' 30, 'WONK' 1;
    color: var(--etcom-lapis-noche);
    line-height: 1.1;
    margin: 2.5em 0 0.8em;
  }
  .body :global(h3) {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--etcom-humo);
    margin: 2em 0 0.8em;
  }
  .body :global(p)  { margin-bottom: 1.5em; }
  .body :global(a)  {
    color: var(--etcom-lapis);
    text-decoration: underline;
    text-decoration-color: var(--etcom-oro);
    text-underline-offset: 3px;
  }
  .body :global(a:hover) { color: var(--etcom-lapis-vivo); }
  .body :global(blockquote) {
    border-left: 3px solid var(--etcom-oro);
    padding: 1em 0 1em 1.5em;
    margin: 1.5em 0;
  }
  .body :global(blockquote p) {
    font-size: var(--font-size-md);
    line-height: 1.5;
    margin: 0;
    font-style: italic;
    color: var(--etcom-lapis);
  }
  .body :global(code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--font-size-sm);
    background: var(--etcom-vitela-claro);
    border: 1px solid var(--etcom-oro-suave);
    padding: 2px 6px;
    border-radius: 3px;
    color: var(--etcom-lapis-noche);
  }
  .body :global(ul), .body :global(ol) {
    padding-left: 1.5em;
    margin-bottom: 1.5em;
  }
  .body :global(li) {
    margin-bottom: 0.5em;
    line-height: 1.8;
  }
</style>
